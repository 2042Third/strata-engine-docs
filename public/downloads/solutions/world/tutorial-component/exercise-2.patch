@@ -2,6 +2,11 @@
 
 #include "Physics/PhysicsTestUtils.h"
 #include "Strata/Physics/WindZoneSystem.h"
+#include "Strata/Scene/SceneSerializer.h"
+#include "Strata/Scene/UnknownComponents.h"
+
+#include <string>
+#include <vector>
 
 using namespace Strata;
 using namespace Strata::Tests;
@@ -55,4 +60,30 @@ TEST_SUITE("Physics.WindZone")
 		CHECK(system->GetZones().empty());
 		scene.OnRuntimeStop();
 	}
+
+	TEST_CASE("A scene saved under the old name keeps its zone as an unknown component and saves it back unchanged")
+	{
+		const nlohmann::json zone = { { "Strength", 25 }, { "Radius", 8.5 }, { "Mode", "Spherical" } };
+		const nlohmann::json document = {
+			{ "Strata", { { "Format", "Scene" }, { "Version", 1 } } },
+			{ "Scene", { { "Name", "Old" }, { "Entities", { { { "ID", "00000000000000AE" }, { "Components", {
+				{ "Name", { { "Name", "Gust" } } }, { "WindZone", zone } } } } } } } }
+		};
+		Scene scene;
+		std::string error;
+		std::vector<std::string> warnings;
+		REQUIRE_MESSAGE(SceneSerializer::Deserialize(scene, document, &error, &warnings), error);
+		REQUIRE(warnings.size() == 1);
+		CHECK(warnings[0].find("Unknown component 'WindZone' (1 entity) kept unchanged") != std::string::npos);
+
+		Entity gust = scene.GetEntityByUUID(UUID(0xAE));
+		CHECK_FALSE(gust.HasComponent<WindZoneComponent>());
+		REQUIRE(gust.HasComponent<UnknownComponentsComponent>());
+		CHECK(gust.GetComponent<UnknownComponentsComponent>().Components["WindZone"] == zone);
+		scene.OnRuntimeStart();
+		StepScene(scene, 1);
+		CHECK(scene.GetSystem<WindZoneSystem>()->GetZones().empty());
+		scene.OnRuntimeStop();
+		CHECK(SceneSerializer::Serialize(scene)["Scene"]["Entities"][0]["Components"]["WindZone"] == zone);
+	}
 }
