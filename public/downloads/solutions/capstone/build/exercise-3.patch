+	float GetGustFactor(uint64_t fixedStep)
+	{
+		// The remainder first: a long run keeps the angle small, so that the sine stays exact.
+		const float phase = static_cast<float>(fixedStep % c_GustPeriodSteps) / static_cast<float>(c_GustPeriodSteps);
+		return 1.0f + 0.5f * std::sin(phase * 6.28318530718f);
+	}
