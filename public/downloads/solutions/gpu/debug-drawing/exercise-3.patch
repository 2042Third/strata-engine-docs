 #include "Physics/PhysicsTestUtils.h"
 #include "Strata/Physics/WindZoneSystem.h"
+#include "Strata/Renderer/SceneGizmos.h"
 
 using namespace Strata;
 using namespace Strata::Tests;
@@ -55,4 +56,28 @@ TEST_SUITE("Physics.WindZone")
 		CHECK(system->GetZones().empty());
 		scene.OnRuntimeStop();
 	}
+
+	TEST_CASE("A wind zone shows a sphere of its radius around its origin, and none for a zone without reach")
+	{
+		Scene scene;
+		Entity gust = scene.CreateEntity("Gust");
+		gust.GetTransform().Translation = { 4.0f, 1.0f, -2.0f };
+		gust.MarkModified<TransformComponent>();
+		gust.AddComponent<WindZoneComponent>().Radius = 3.0f;
+		scene.UpdateWorldTransforms();
+
+		SceneGizmoSettings settings;
+		settings.Lights = false;
+		settings.Cameras = false;
+		DebugDraw debugDraw;
+		DrawSceneGizmos(debugDraw, scene, settings);
+		CHECK(debugDraw.GetLineCount() == 3 * 32); // Three great circles of 32 segments
+		for (const DebugLineVertex& vertex : debugDraw.GetLines(DebugDrawDepth::Tested))
+			CHECK(glm::distance(vertex.Position, glm::vec3(4.0f, 1.0f, -2.0f)) == doctest::Approx(3.0f));
+
+		gust.GetComponent<WindZoneComponent>().Radius = 0.0f;
+		debugDraw.Clear();
+		DrawSceneGizmos(debugDraw, scene, settings);
+		CHECK(debugDraw.IsEmpty());
+	}
 }
