[
	{
		"command": "asset.import",
		"parameters": {
			"file": "<release folder>/Samples/ThirdPerson/Assets/Models/Platformer/flag.glb",
			"directory": "Models"
		}
	},
	{
		"command": "asset.place",
		"parameters": {
			"asset": "Models/flag/flag.glb",
			"point": [
				3,
				0,
				0
			]
		},
		"bind": {
			"flag": "/id"
		}
	},
	{
		"command": "entity.find",
		"parameters": {
			"name": "Robot"
		},
		"bind": {
			"robot": "/entities/0"
		}
	},
	{
		"command": "entity.create",
		"parameters": {
			"name": "FlagHolder",
			"components": {
				"AttachToJoint": {
					"Animator": {
						"$ref": "robot"
					},
					"Joint": "Palm2.R"
				}
			}
		},
		"bind": {
			"holder": "/id"
		}
	},
	{
		"command": "entity.setParent",
		"parameters": {
			"entity": {
				"$ref": "flag"
			},
