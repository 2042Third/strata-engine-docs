				"Translation": [
					0,
					0.008,
					0
				],
				"Rotation": [
					180,
					0,
					0
				],
				"Scale": [
					0.035,
					0.035,
					0.035
				]
			}
		}
	},
	{
		"command": "entity.find",
		"parameters": {
			"name": "FlagHolder"
		},
		"bind": {
			"entityName.1": "/entities/0"
		}
	},
	{
		"command": "component.get",
		"parameters": {
			"component": "Transform",
			"entity": {
				"$ref": "entityName.1"
			}
		}
	},
	{
		"command": "play.start",
		"parameters": {
			"paused": true,
			"build": false
		}
