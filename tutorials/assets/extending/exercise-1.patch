diff --git a/StrataTests/src/Scene/TextAssetTests.cpp b/StrataTests/src/Scene/TextAssetTests.cpp
index 0432a403..71513be4 100644
--- a/StrataTests/src/Scene/TextAssetTests.cpp
+++ b/StrataTests/src/Scene/TextAssetTests.cpp
@@ -52,4 +52,37 @@ TEST_SUITE("Scene.TextAsset")
 		CHECK_FALSE(importer->Import(context, rejected, &error));
 		CHECK_FALSE(error.empty());
 	}
+
+	TEST_CASE("The importer writes one line end, and Newline is inactive without it")
+	{
+		const AssetImporter* importer = AssetImporterRegistry::FindByExtension(".sttxt");
+		REQUIRE(importer);
+		CHECK(importer->GetVersion() == 2);
+
+		const std::filesystem::path directory = Tests::CreateTemporaryDirectory("TextNewlines");
+		const std::filesystem::path path = directory / "Mixed.sttxt";
+		std::ofstream(path, std::ios::binary) << "a\r\nb\rc\n";
+		const auto importWith = [&](bool normalize, const char* newline)
+		{
+			ImportContext context;
+			context.SourcePath = path;
+			context.AssetDirectory = directory;
+			context.Settings = nlohmann::json::object();
+			context.Settings["NormalizeLineEndings"] = normalize;
+			context.Settings["Newline"] = newline;
+			ImportResult result;
+			std::string error;
+			REQUIRE_MESSAGE(importer->Import(context, result, &error), error);
+			return std::string(result.Data.begin(), result.Data.end());
+		};
+		CHECK(importWith(true, "LF") == "a\nb\nc\n");
+		CHECK(importWith(true, "CRLF") == "a\r\nb\r\nc\r\n");
+		CHECK(importWith(false, "LF") == "a\r\nb\rc\n");
+
+		nlohmann::json settings = importer->GetDefaultSettings(path);
+		CHECK(importer->GetInactiveReason("Newline", settings).empty());
+		settings["NormalizeLineEndings"] = false;
+		CHECK_FALSE(importer->GetInactiveReason("Newline", settings).empty());
+		CHECK(importer->GetInactiveReason("NormalizeLineEndings", settings).empty());
+	}
 }
