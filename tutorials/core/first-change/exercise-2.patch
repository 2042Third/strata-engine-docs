+
+	TEST_CASE("A prefix matches whatever the case of its letters")
+	{
+		CHECK(StringUtils::StartsWithIgnoreCase("Gamepad.A", "gamepad."));
+		CHECK(StringUtils::StartsWithIgnoreCase("KEY.SPACE", "Key."));
+		CHECK(StringUtils::StartsWithIgnoreCase("anything", ""));
+		CHECK_FALSE(StringUtils::StartsWithIgnoreCase("Key", "Keyboard."));
+		CHECK_FALSE(StringUtils::StartsWithIgnoreCase("Mouse.Left", "Key."));
