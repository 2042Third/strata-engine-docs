+	// Counts the frames whose update it sees and logs the total when the program stops.
+	class FrameCounterModule : public EngineModule
+	{
+	public:
+		static constexpr std::string_view c_Name = "FrameCounter";
+
+		static EngineModuleFactory Factory()
+		{
+			return []() -> Scope<EngineModule> { return CreateScope<FrameCounterModule>(); };
+		}
+
+		std::string_view GetName() const override { return c_Name; }
+		[[nodiscard]] bool OnInit(EngineContext&) override { return true; }
+		void OnUpdate(EngineFrame&) override { m_Frames++; }
+		void OnStop() override { ST_CORE_INFO("FrameCounter counted {} frames", m_Frames); }
+
+		uint64_t GetFrames() const { return m_Frames; }
+	private:
+		uint64_t m_Frames = 0;
+	};
+
 	// What a module released after the Project module (listed before it) finds when it is released.
 	struct ReleaseObservation
 	{
@@ -535,4 +556,22 @@
 		CHECK(registry.GetCount() == 0);
 		CHECK(registry.Find<AlphaModule>() == nullptr);
