+
+	TEST_CASE("A module found by its type counts the frames it updates and logs the total when the program stops")
+	{
+		Journal journal;
+		const Tests::ScopedLogLevel infoLog(LogLevel::Info);
+		const uint64_t logStart = Log::GetBuffer().GetLatestSequence();
+		{
+			JournalApplication application(MakeSpecification({ FrameCounterModule::Factory() }, 3), journal);
+			REQUIRE(application.IsRunning());
+			const FrameCounterModule* counter = application.GetModules().Find<FrameCounterModule>();
+			REQUIRE(counter);
+			CHECK(counter->GetFrames() == 0);
+			application.Run();
+			CHECK(application.GetFrameCount() == 3);
+			CHECK(counter->GetFrames() == 3);
+		}
+		CHECK(Tests::CountLogMessages(logStart, "FrameCounter counted 3 frames") == 1);
+	}
 }
