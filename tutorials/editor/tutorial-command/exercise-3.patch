+	TEST_CASE("wind.set names every entity without a zone in the error's data")
+	{
+		WindHarness harness;
+		const UUID breeze = harness.AddZone("Breeze", 10.0f, 5.0f).GetUUID();
+		const UUID rock = harness.GetScene().CreateEntity("Rock").GetUUID();
+		const UUID lamp = harness.GetScene().CreateEntity("Lamp").GetUUID();
+
+		const EditorCommandResult result = harness.Execute("wind.set", { { "entities", WindHarness::Ids({ breeze, rock, lamp }) },
+			{ "strength", 20.0 } });
+		REQUIRE_FALSE(result.Success);
+		REQUIRE(result.ErrorData["withoutWindZone"].size() == 2);
+		CHECK(result.ErrorData["withoutWindZone"][0]["name"] == "Rock");
+		CHECK(result.ErrorData["withoutWindZone"][1]["entity"] == UUIDToJson(lamp));
+		CHECK(harness.Wind(breeze).Strength == doctest::Approx(10.0f));
+	}
