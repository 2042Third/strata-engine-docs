+	// A scratch layer for learning Dear ImGui: one window with a counter.
+	class ScratchLayer : public Layer
+	{
+	public:
+		ScratchLayer()
+			: Layer("Scratch")
+		{
+		}
+
+		void OnImGuiRender() override
+		{
+			bool askToReset = false;
+			if (ImGui::Begin("Scratch", nullptr, ImGuiWindowFlags_MenuBar))
+			{
+				if (ImGui::BeginMenuBar())
+				{
+					if (ImGui::BeginMenu("Counter"))
+					{
+						// OpenPopup hashes its name under the current ID stack, and a menu is a window of its own:
+						// the request is remembered and the popup opened below, in the Scratch window's scope.
+						if (ImGui::MenuItem("Reset counter"))
+							askToReset = true;
+						ImGui::EndMenu();
+					}
+					ImGui::EndMenuBar();
+				}
+				ImGui::Text("Count: %d", m_Count);
+				ImGui::SameLine();
+				if (ImGui::Button("Add"))
+					m_Count++;
+				if (askToReset)
+					ImGui::OpenPopup("Reset the counter?");
+				if (ImGui::BeginPopupModal("Reset the counter?", nullptr, ImGuiWindowFlags_AlwaysAutoResize))
+				{
+					ImGui::Text("The count of %d is lost.", m_Count);
+					if (ImGui::Button("Reset"))
+					{
+						m_Count = 0;
+						ImGui::CloseCurrentPopup();
+					}
+					ImGui::SameLine();
+					if (ImGui::Button("Cancel"))
+						ImGui::CloseCurrentPopup();
+					ImGui::EndPopup();
+				}
+			}
+			ImGui::End();
+		}
+	private:
+		int m_Count = 0;
+	};
+
