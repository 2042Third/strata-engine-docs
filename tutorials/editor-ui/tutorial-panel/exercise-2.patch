+	TEST_CASE("The summary lists the names of the selection in selection order")
+	{
+		HarnessEditor editor({}, WithFeatureProject("SelectionSummaryNames"));
+		editor.Frames(2);
+		MakeEntities(editor);
+		editor.Run("editor.showPanel", { { "panel", "SelectionSummary" } });
+		Select(editor, { "SummaryTorch", "SummaryCrate", "SummaryLamp" });
+		const SelectionSummaryPanel* panel = editor.Layer->GetPanels().Get<SelectionSummaryPanel>(EditorPanels::c_SelectionSummary);
+		REQUIRE(panel);
+		REQUIRE(panel->GetNames().size() == 3);
+		CHECK(panel->GetNames()[0] == "SummaryTorch");
+		CHECK(panel->GetNames()[1] == "SummaryCrate");
+		CHECK(panel->GetNames()[2] == "SummaryLamp");
+	}
