{
	"page": "make/project-tetris",
	"startsFrom": { "template": "basic3d" },
	"stages": [
		{
			"step": 1,
			"commands": [
				{ "command": "entity.find", "parameters": { "name": "Ground" }, "bind": { "groundId": "/entities/0" } },
				{ "command": "entity.delete", "parameters": { "entities": [{ "$ref": "groundId" }] } },
				{ "command": "material.create", "parameters": { "path": "Materials/Wall.stmat", "properties": { "BaseColor": [0.35, 0.38, 0.45, 1.0], "Metallic": 0.2, "Roughness": 0.7 } } },
				{ "command": "material.create", "parameters": { "path": "Materials/Backdrop.stmat", "properties": { "BaseColor": [0.04, 0.045, 0.06, 1.0], "Roughness": 0.9 } } },
				{ "command": "entity.create", "parameters": { "name": "Well" } },
				{ "command": "entity.find", "parameters": { "name": "Well" }, "bind": { "wellId": "/entities/0" } },
				{ "command": "entity.create", "parameters": { "name": "LeftWall", "parent": { "$ref": "wellId" }, "components": { "MeshRenderer": { "Mesh": "Builtin/Cube", "Material": "Materials/Wall.stmat" }, "Transform": { "Translation": [-1, 9.5, 0], "Scale": [1, 22, 1] } } } },
				{ "command": "entity.find", "parameters": { "name": "Well" }, "bind": { "wellId": "/entities/0" } },
				{ "command": "entity.create", "parameters": { "name": "RightWall", "parent": { "$ref": "wellId" }, "components": { "MeshRenderer": { "Mesh": "Builtin/Cube", "Material": "Materials/Wall.stmat" }, "Transform": { "Translation": [10, 9.5, 0], "Scale": [1, 22, 1] } } } },
				{ "command": "entity.find", "parameters": { "name": "Well" }, "bind": { "wellId": "/entities/0" } },
				{ "command": "entity.create", "parameters": { "name": "Floor", "parent": { "$ref": "wellId" }, "components": { "MeshRenderer": { "Mesh": "Builtin/Cube", "Material": "Materials/Wall.stmat" }, "Transform": { "Translation": [4.5, -1, 0], "Scale": [10, 1, 1] } } } },
				{ "command": "entity.find", "parameters": { "name": "Well" }, "bind": { "wellId": "/entities/0" } },
				{ "command": "entity.create", "parameters": { "name": "Backdrop", "parent": { "$ref": "wellId" }, "components": { "MeshRenderer": { "Mesh": "Builtin/Cube", "Material": "Materials/Backdrop.stmat" }, "Transform": { "Translation": [4.5, 9.5, -0.75], "Scale": [10, 20, 0.5] } } } },
				{ "command": "entity.find", "parameters": { "name": "Well" }, "bind": { "wellId": "/entities/0" } },
				{ "command": "entity.create", "parameters": { "name": "PreviewBackdrop", "parent": { "$ref": "wellId" }, "components": { "MeshRenderer": { "Mesh": "Builtin/Cube", "Material": "Materials/Backdrop.stmat" }, "Transform": { "Translation": [13.5, 16, -0.75], "Scale": [5, 4, 0.5] } } } },
				{ "command": "component.set", "entityName": "Main Camera", "parameters": { "component": "Transform", "values": { "Translation": [5.5, 9.5, 30], "Rotation": [0, 0, 0] } } }
			],
			"endState": true
		},
		{
			"step": 2,
			"files": [
				{ "from": "book:tutorials/make/project-tetris/TetrisGame.h", "to": "Scripts/TetrisGame.h" },
				{ "from": "book:tutorials/make/project-tetris/TetrisGame.cpp", "to": "Scripts/TetrisGame.cpp" },
				{ "from": "book:tutorials/make/project-tetris/TetrisBoard.step2.cpp", "to": "Scripts/TetrisBoard.cpp" }
			],
			"commands": [
				{ "command": "script.build", "expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "entity.create", "parameters": { "name": "Board" } },
				{ "command": "script.add", "entityName": "Board", "parameters": { "class": "TetrisBoard" } },
				{ "command": "script.get", "entityName": "Board", "parameters": { "class": "TetrisBoard" }, "checks": [ { "pointer": "/scripts/0/fields/Seed", "equals": 60 } ] },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 2 }, "expect": { "/stepsRun": { "equals": 2 } } },
				{ "command": "log.read", "parameters": { "newest": true, "limit": 50 }, "checks": [ { "pointer": "/messages", "contains": "Tetris: new game with seed 60" }, { "pointer": "/messages", "contains": "Tetris: piece 1 is J, next I" } ] },
				{ "command": "play.stop" }
			],
			"endState": true
		},
		{
			"step": 3,
			"files": [ { "from": "book:tutorials/make/project-tetris/TetrisBoard.step3.cpp", "to": "Scripts/TetrisBoard.cpp" } ],
			"commands": [
				{ "command": "material.create", "parameters": { "path": "Materials/PieceI.stmat", "properties": { "BaseColor": [0.0, 0.85, 0.95, 1.0], "Roughness": 0.35 } } },
				{ "command": "material.create", "parameters": { "path": "Materials/PieceO.stmat", "properties": { "BaseColor": [0.95, 0.8, 0.05, 1.0], "Roughness": 0.35 } } },
				{ "command": "material.create", "parameters": { "path": "Materials/PieceT.stmat", "properties": { "BaseColor": [0.6, 0.15, 0.85, 1.0], "Roughness": 0.35 } } },
				{ "command": "material.create", "parameters": { "path": "Materials/PieceS.stmat", "properties": { "BaseColor": [0.15, 0.8, 0.2, 1.0], "Roughness": 0.35 } } },
				{ "command": "material.create", "parameters": { "path": "Materials/PieceZ.stmat", "properties": { "BaseColor": [0.9, 0.12, 0.12, 1.0], "Roughness": 0.35 } } },
				{ "command": "material.create", "parameters": { "path": "Materials/PieceJ.stmat", "properties": { "BaseColor": [0.12, 0.3, 0.95, 1.0], "Roughness": 0.35 } } },
				{ "command": "material.create", "parameters": { "path": "Materials/PieceL.stmat", "properties": { "BaseColor": [0.95, 0.5, 0.05, 1.0], "Roughness": 0.35 } } },
				{ "command": "material.create", "parameters": { "path": "Materials/Ghost.stmat", "properties": { "BaseColor": [0.8, 0.85, 1.0, 0.25], "AlphaMode": "Blend", "Roughness": 0.6 } } },
				{ "command": "script.build", "expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MaterialI", "value": "Materials/PieceI.stmat" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MaterialO", "value": "Materials/PieceO.stmat" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MaterialT", "value": "Materials/PieceT.stmat" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MaterialS", "value": "Materials/PieceS.stmat" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MaterialZ", "value": "Materials/PieceZ.stmat" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MaterialJ", "value": "Materials/PieceJ.stmat" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MaterialL", "value": "Materials/PieceL.stmat" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "GhostMaterial", "value": "Materials/Ghost.stmat" } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 2 }, "expect": { "/stepsRun": { "equals": 2 } } },
				{ "command": "play.stop" }
			],
			"endState": true
		},
		{
			"step": 4,
			"files": [ { "from": "book:tutorials/make/project-tetris/TetrisBoard.step4.cpp", "to": "Scripts/TetrisBoard.cpp" } ],
			"commands": [
				{ "command": "script.build", "expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.get", "entityName": "Board", "parameters": { "class": "TetrisBoard" }, "checks": [ { "pointer": "/scripts/0/fields/StartInterval", "approx": 0.8, "tolerance": 0.0001 }, { "pointer": "/scripts/0/fields/SoftDropInterval", "approx": 0.04, "tolerance": 0.0001 }, { "pointer": "/scripts/0/fields/MaterialI", "length": 16 }, { "pointer": "/scripts/0/fields/GhostMaterial", "length": 16 } ] },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "input.sequence", "parameters": { "steps": 4, "events": [ { "step": 0, "key": "Left", "action": "tap" }, { "step": 2, "key": "Space", "action": "tap" } ] }, "expect": { "/stepsRun": { "equals": 4 } } },
				{ "command": "log.read", "parameters": { "newest": true, "limit": 50 }, "checks": [ { "pointer": "/messages", "contains": "Tetris: piece 2 is I, next L" } ] },
				{ "command": "input.sequence", "parameters": { "steps": 24, "events": [ { "step": 0, "key": "Down", "action": "press" }, { "step": 23, "key": "Down", "action": "release" } ] }, "expect": { "/stepsRun": { "equals": 24 } } },
				{ "command": "play.step", "parameters": { "steps": 48 }, "expect": { "/stepsRun": { "equals": 48 } } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MinInterval", "value": 0.01 } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "StartInterval", "value": 0.01 } },
				{ "command": "play.step", "parameters": { "steps": 600 }, "expect": { "/stepsRun": { "equals": 600 } } },
				{ "command": "log.read", "parameters": { "newest": true, "limit": 100 }, "checks": [ { "pointer": "/messages", "contains": "Tetris: game over after" } ] },
				{ "command": "play.stop" },
				{ "command": "script.get", "entityName": "Board", "parameters": { "class": "TetrisBoard" }, "checks": [ { "pointer": "/scripts/0/fields/StartInterval", "approx": 0.8, "tolerance": 0.0001 } ] }
			],
			"endState": true
		},
		{
			"step": 5,
			"files": [ { "from": "book:tutorials/make/project-tetris/TetrisBoard.step5.cpp", "to": "Scripts/TetrisBoard.cpp" } ],
			"commands": [
				{ "command": "ui.create", "parameters": { "type": "canvas", "name": "HUD" } },
				{ "command": "component.set", "entityName": "HUD", "parameters": { "component": "UICanvas", "values": { "ReferenceResolution": [1280, 720] } } },
				{ "command": "entity.find", "parameters": { "name": "HUD" }, "bind": { "hUDId": "/entities/0" } },
				{ "command": "ui.create", "parameters": { "type": "panel", "parent": { "$ref": "hUDId" }, "name": "StatsPanel", "anchor": "topLeft", "position": [48, 56] } },
				{ "command": "component.set", "entityName": "StatsPanel", "parameters": { "component": "UIRect", "values": { "Pivot": [0, 0], "FitContent": "Both" } } },
				{ "command": "component.add", "entityName": "StatsPanel", "parameters": { "component": "UILayout", "values": { "Type": "Vertical", "Padding": [22, 14, 22, 14], "Spacing": [0, 4] } } },
				{ "command": "entity.find", "parameters": { "name": "StatsPanel" }, "bind": { "statsPanelId": "/entities/0" } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "statsPanelId" }, "name": "ScoreText", "text": "Score: 0" } },
				{ "command": "component.set", "entityName": "ScoreText", "parameters": { "component": "UIText", "values": { "FontSize": 36, "Alignment": "Left" } } },
				{ "command": "component.set", "entityName": "ScoreText", "parameters": { "component": "UIRect", "values": { "FitContent": "Both" } } },
				{ "command": "entity.find", "parameters": { "name": "StatsPanel" }, "bind": { "statsPanelId": "/entities/0" } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "statsPanelId" }, "name": "LevelText", "text": "Level: 1" } },
				{ "command": "component.set", "entityName": "LevelText", "parameters": { "component": "UIText", "values": { "FontSize": 30, "Alignment": "Left", "Color": [0.85, 0.9, 1, 1] } } },
				{ "command": "component.set", "entityName": "LevelText", "parameters": { "component": "UIRect", "values": { "FitContent": "Both" } } },
				{ "command": "entity.find", "parameters": { "name": "StatsPanel" }, "bind": { "statsPanelId": "/entities/0" } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "statsPanelId" }, "name": "LinesText", "text": "Lines: 0" } },
				{ "command": "component.set", "entityName": "LinesText", "parameters": { "component": "UIText", "values": { "FontSize": 30, "Alignment": "Left", "Color": [0.85, 0.9, 1, 1] } } },
				{ "command": "component.set", "entityName": "LinesText", "parameters": { "component": "UIRect", "values": { "FitContent": "Both" } } },
				{ "command": "entity.find", "parameters": { "name": "HUD" }, "bind": { "hUDId": "/entities/0" } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "hUDId" }, "name": "ControlsText", "text": "Left/Right: move   Up/X, Z: rotate\nDown: soft drop   Space: hard drop\nP: pause   R: restart   Esc: quit", "anchor": "bottomLeft", "position": [48, -36] } },
				{ "command": "component.set", "entityName": "ControlsText", "parameters": { "component": "UIText", "values": { "FontSize": 18, "Alignment": "Left" } } },
				{ "command": "entity.create", "parameters": { "name": "NextLabel", "components": { "Text": { "Text": "NEXT", "FontSize": 1, "ScreenSpace": false }, "Transform": { "Translation": [13.5, 18.6, 0] } } } },
				{ "command": "script.build", "expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "entity.find", "parameters": { "name": "ScoreText" }, "bind": { "scoreTextId": "/entities/0" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "ScoreText", "value": { "$ref": "scoreTextId" } } },
				{ "command": "entity.find", "parameters": { "name": "LevelText" }, "bind": { "levelTextId": "/entities/0" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "LevelText", "value": { "$ref": "levelTextId" } } },
				{ "command": "entity.find", "parameters": { "name": "LinesText" }, "bind": { "linesTextId": "/entities/0" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "LinesText", "value": { "$ref": "linesTextId" } } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 1 }, "expect": { "/stepsRun": { "equals": 1 } } },
				{ "command": "component.get", "entityName": "ScoreText", "parameters": { "component": "UIText" }, "checks": [ { "pointer": "/values/Text", "equals": "Score: 0" } ] },
				{ "command": "input.sequence", "parameters": { "steps": 3, "events": [ { "step": 0, "key": "Space", "action": "tap" } ] }, "expect": { "/stepsRun": { "equals": 3 } } },
				{ "command": "component.get", "entityName": "ScoreText", "parameters": { "component": "UIText" }, "checks": [ { "pointer": "/values/Text", "equals": "Score: 36" } ] },
				{ "command": "play.stop" }
			],
			"endState": true
		},
		{
			"step": 6,
			"files": [
				{ "from": "book:tutorials/make/project-tetris/TetrisBoard.cpp", "to": "Scripts/TetrisBoard.cpp" }
			],
			"commands": [
				{ "command": "asset.import", "parameters": { "files": ["@RELEASE@/Samples/Tetris/Assets/Sounds/Move.wav", "@RELEASE@/Samples/Tetris/Assets/Sounds/Lock.wav", "@RELEASE@/Samples/Tetris/Assets/Sounds/Clear.wav", "@RELEASE@/Samples/Tetris/Assets/Sounds/GameOver.wav"], "directory": "Sounds" } },
				{ "command": "entity.find", "parameters": { "name": "HUD" }, "bind": { "hUDId": "/entities/0" } },
				{ "command": "ui.create", "parameters": { "type": "panel", "parent": { "$ref": "hUDId" }, "name": "MessagePanel", "anchor": "middleCenter" } },
				{ "command": "component.set", "entityName": "MessagePanel", "parameters": { "component": "UIRect", "values": { "AnchorMin": [0.5, 0.42], "AnchorMax": [0.5, 0.42], "FitContent": "Both" } } },
				{ "command": "component.add", "entityName": "MessagePanel", "parameters": { "component": "UILayout", "values": { "Type": "Vertical", "ChildAlignment": "MiddleCenter", "Padding": [44, 26, 44, 26] } } },
				{ "command": "entity.find", "parameters": { "name": "MessagePanel" }, "bind": { "messagePanelId": "/entities/0" } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "messagePanelId" }, "name": "MessageText", "text": "" } },
				{ "command": "component.set", "entityName": "MessageText", "parameters": { "component": "UIText", "values": { "FontSize": 44, "Alignment": "Center", "Color": [1, 0.9, 0.3, 1] } } },
				{ "command": "component.set", "entityName": "MessageText", "parameters": { "component": "UIRect", "values": { "FitContent": "Both" } } },
				{ "command": "entity.setActive", "entityName": "MessagePanel", "parameters": { "active": false } },
				{ "command": "script.build", "expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "entity.find", "parameters": { "name": "MessageText" }, "bind": { "messageTextId": "/entities/0" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MessageText", "value": { "$ref": "messageTextId" } } },
				{ "command": "entity.find", "parameters": { "name": "MessagePanel" }, "bind": { "messagePanelId": "/entities/0" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MessagePanel", "value": { "$ref": "messagePanelId" } } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MoveSound", "value": "Sounds/Move.wav" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "LockSound", "value": "Sounds/Lock.wav" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "ClearSound", "value": "Sounds/Clear.wav" } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "GameOverSound", "value": "Sounds/GameOver.wav" } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "input.sequence", "parameters": { "steps": 3, "events": [ { "step": 0, "key": "P", "action": "tap" } ] }, "expect": { "/stepsRun": { "equals": 3 } } },
				{ "command": "component.get", "entityName": "MessageText", "parameters": { "component": "UIText" }, "checks": [ { "pointer": "/values/Text", "equals": "PAUSED\nPress P to continue" } ] },
				{ "command": "entity.get", "entityName": "MessagePanel", "checks": [ { "pointer": "/active", "equals": true } ] },
				{ "command": "input.sequence", "parameters": { "steps": 3, "events": [ { "step": 0, "key": "P", "action": "tap" } ] }, "expect": { "/stepsRun": { "equals": 3 } } },
				{ "command": "component.get", "entityName": "MessageText", "parameters": { "component": "UIText" }, "checks": [ { "pointer": "/values/Text", "equals": "" } ] },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "MinInterval", "value": 0.01 } },
				{ "command": "script.setField", "entityName": "Board", "parameters": { "class": "TetrisBoard", "field": "StartInterval", "value": 0.01 } },
				{ "command": "play.step", "parameters": { "steps": 600 }, "expect": { "/stepsRun": { "equals": 600 } } },
				{ "command": "component.get", "entityName": "MessageText", "parameters": { "component": "UIText" }, "checks": [ { "pointer": "/values/Text", "equals": "GAME OVER\nPress R or Enter to play again" } ] },
				{ "command": "input.sequence", "parameters": { "steps": 3, "events": [ { "step": 0, "key": "R", "action": "tap" } ] }, "expect": { "/stepsRun": { "equals": 3 } } },
				{ "command": "component.get", "entityName": "MessageText", "parameters": { "component": "UIText" }, "checks": [ { "pointer": "/values/Text", "equals": "" } ] },
				{ "command": "component.get", "entityName": "ScoreText", "parameters": { "component": "UIText" }, "checks": [ { "pointer": "/values/Text", "equals": "Score: 0" } ] },
				{ "command": "script.get", "entityName": "Board", "parameters": { "class": "TetrisBoard" }, "checks": [ { "pointer": "/scripts/0/fields/MoveSound", "length": 16 }, { "pointer": "/scripts/0/fields/GameOverSound", "length": 16 } ] },
				{ "command": "entity.find", "parameters": { "name": "Cells" }, "checks": [ { "pointer": "/entities", "length": 1 } ], "bind": { "cellsId": "/entities/0" } },
				{ "command": "entity.get", "parameters": { "entity": { "$ref": "cellsId" } }, "checks": [ { "pointer": "/children", "length": 204 } ] },
				{ "command": "play.stop" }
			],
			"endState": true
		},
		{
			"step": 7,
			"files": [ { "from": "book:tutorials/make/project-tetris/Playtest.json", "to": "Playtest.json" } ],
			"commands": [
				{ "command": "entity.find", "parameters": { "name": "Board" }, "bind": { "board": "/entities/0" } },
				{ "command": "entity.find", "parameters": { "name": "ScoreText" }, "bind": { "score": "/entities/0" } },
				{ "command": "entity.find", "parameters": { "name": "LinesText" }, "bind": { "lines": "/entities/0" } },
				{ "command": "entity.find", "parameters": { "name": "LevelText" }, "bind": { "level": "/entities/0" } },
				{ "command": "entity.find", "parameters": { "name": "MessageText" }, "bind": { "message": "/entities/0" } },
				{ "command": "script.setField", "parameters": { "entity": { "$ref": "board" }, "class": "TetrisBoard", "field": "LinesPerLevel", "value": 1 } },
				{ "command": "script.setField", "parameters": { "entity": { "$ref": "board" }, "class": "TetrisBoard", "field": "StartInterval", "value": 100 } },
				{ "command": "ui.layout", "parameters": { "entity": { "$ref": "score" }, "screen": [1280, 720] },
					"expect": { "/elements/0/rect": { "equals": [70, 70, 131.677734375, 42.1875] } } },
				{ "command": "ui.layout", "parameters": { "entity": { "$ref": "score" }, "screen": [2560, 1440] },
					"expect": { "/elements/0/rect": { "equals": [140, 140, 263.35546875, 84.375] } } },
				{ "command": "play.start", "expect": { "/state": { "equals": "Play" } } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "score" }, "component": "UIText" }, "expect": { "/values/Text": { "equals": "Score: 0" } } },
				{ "command": "input.sequence", "parameters": { "steps": 26, "events": [
					{ "step": 0, "key": "Left", "action": "tap" }, { "step": 2, "key": "Left", "action": "tap" }, { "step": 4, "key": "Left", "action": "tap" }, { "step": 6, "key": "Space", "action": "tap" },
					{ "step": 8, "key": "Up", "action": "tap" }, { "step": 10, "key": "Z", "action": "tap" }, { "step": 12, "key": "Down", "action": "tap" }, { "step": 14, "key": "Space", "action": "tap" },
					{ "step": 16, "key": "Right", "action": "tap" }, { "step": 18, "key": "Right", "action": "tap" }, { "step": 20, "key": "Right", "action": "tap" }, { "step": 22, "key": "Right", "action": "tap" }, { "step": 24, "key": "Space", "action": "tap" }
				] }, "expect": { "/stepsRun": { "equals": 26 } } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "lines" }, "component": "UIText" }, "expect": { "/values/Text": { "equals": "Lines: 1" } } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "score" }, "component": "UIText" }, "expect": { "/values/Text": { "equals": "Score: 209" } } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "level" }, "component": "UIText" }, "expect": { "/values/Text": { "equals": "Level: 2" } } },
				{ "command": "script.setField", "parameters": { "entity": { "$ref": "board" }, "class": "TetrisBoard", "field": "MinInterval", "value": 0.01 } },
				{ "command": "script.setField", "parameters": { "entity": { "$ref": "board" }, "class": "TetrisBoard", "field": "StartInterval", "value": 0.01 } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "message" }, "component": "UIText" },
					"expect": { "/values/Text": { "equals": "GAME OVER\nPress R or Enter to play again" } }, "until": { "steps": 3000, "seconds": 60 } },
				{ "command": "script.setField", "parameters": { "entity": { "$ref": "board" }, "class": "TetrisBoard", "field": "StartInterval", "value": 100 } },
				{ "command": "input.key", "parameters": { "key": "R" } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "message" }, "component": "UIText" }, "expect": { "/values/Text": { "equals": "" } } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "score" }, "component": "UIText" }, "expect": { "/values/Text": { "equals": "Score: 0" } } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "lines" }, "component": "UIText" }, "expect": { "/values/Text": { "equals": "Lines: 0" } } },
				{ "command": "log.read", "parameters": { "newest": true, "limit": 200 }, "checks": [ { "pointer": "/messages", "contains": "Tetris: cleared 1 line; score 209, lines 1, level 2" }, { "pointer": "/messages", "contains": "Tetris: game over after" } ] },
				{ "command": "play.stop", "expect": { "/state": { "equals": "Edit" } } },
				{ "command": "edit.undo" },
				{ "command": "edit.undo" },
				{ "command": "scene.info", "expect": { "/modified": { "equals": false } } }
			],
			"endState": true
		},
