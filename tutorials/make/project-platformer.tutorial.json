{
	"page": "make/project-platformer",
	"startsFrom": { "template": "basic3d" },
	"stages": [
		{
			"step": 1,
			"commands": [
				{ "command": "scene.saveAs", "parameters": { "path": "Scenes/Course.stscene" } },
				{ "command": "project.setStartScene", "parameters": { "scene": "Scenes/Course.stscene" } },
				{ "command": "asset.import", "parameters": { "file": "@RELEASE@/Samples/ThirdPerson/Assets/Models/Robot/RobotExpressive.glb", "directory": "Models/Robot" } },
				{ "command": "asset.import", "parameters": { "files": [ "@RELEASE@/Samples/ThirdPerson/Assets/Models/Platformer/block-grass-large-tall.glb", "@RELEASE@/Samples/ThirdPerson/Assets/Models/Platformer/coin-gold.glb", "@RELEASE@/Samples/ThirdPerson/Assets/Models/Platformer/spring.glb", "@RELEASE@/Samples/ThirdPerson/Assets/Models/Platformer/flag.glb", "@RELEASE@/Samples/ThirdPerson/Assets/Models/Platformer/platform.glb" ], "directory": "Models/Platformer" } },
				{ "command": "asset.import", "parameters": { "files": [ "@RELEASE@/Samples/ThirdPerson/Assets/Sounds/Jump.ogg", "@RELEASE@/Samples/ThirdPerson/Assets/Sounds/Land.ogg", "@RELEASE@/Samples/ThirdPerson/Assets/Sounds/Coin.ogg", "@RELEASE@/Samples/ThirdPerson/Assets/Sounds/Bounce.ogg", "@RELEASE@/Samples/ThirdPerson/Assets/Sounds/Complete.ogg" ], "directory": "Sounds" } },
				{ "command": "asset.import", "parameters": { "files": [ "@RELEASE@/Samples/ThirdPerson/Assets/Sounds/Footsteps/Grass1.ogg", "@RELEASE@/Samples/ThirdPerson/Assets/Sounds/Footsteps/Grass2.ogg", "@RELEASE@/Samples/ThirdPerson/Assets/Sounds/Footsteps/Grass3.ogg", "@RELEASE@/Samples/ThirdPerson/Assets/Sounds/Footsteps/Grass4.ogg" ], "directory": "Sounds/Footsteps" } },
				{ "command": "asset.info", "parameters": { "asset": "Models/Platformer/block-grass-large-tall/block-grass-large-tall.glb" } }
			],
			"endState": true
		},
		{
			"step": 2,
			"commands": [
				{ "command": "entity.find", "parameters": { "name": "Ground" }, "bind": { "ground": "/entities/0" } },
				{ "command": "entity.delete", "parameters": { "entities": [ { "$ref": "ground" } ] } },
				{ "command": "entity.find", "parameters": { "name": "Ground" }, "checks": [ { "pointer": "/entities", "length": 0 } ] },
				{ "command": "asset.place", "parameters": { "asset": "Models/Platformer/block-grass-large-tall/block-grass-large-tall.glb", "point": [ 0, 0, 0 ], "scale": 2 },
					"bind": { "block": "/id" } },
				{ "command": "entity.rename", "parameters": { "entity": { "$ref": "block" }, "name": "BlockTall" } },
				{ "command": "entity.find", "parameters": { "name": "block-grass-large-tall" }, "bind": { "blockMesh": "/entities/0" } },
				{ "command": "component.add", "parameters": { "entity": { "$ref": "blockMesh" }, "component": "RigidBody", "values": { "Type": "Static" } } },
				{ "command": "component.add", "parameters": { "entity": { "$ref": "blockMesh" }, "component": "MeshCollider", "values": { "Convex": false } } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "blockMesh" }, "component": "MeshCollider" },
					"checks": [ { "pointer": "/values/Convex", "equals": false } ] },
				{ "command": "selection.set", "parameters": { "entities": [ { "$ref": "blockMesh" } ] } },
				{ "command": "prefab.create", "parameters": { "entities": [ { "$ref": "block" } ], "path": "Prefabs/Course/BlockTall.stprefab" },
					"checks": [ { "pointer": "/linked", "equals": true } ] },
				{ "command": "entity.create", "parameters": { "name": "Course" }, "bind": { "course": "/id" } },
				{ "command": "entity.delete", "parameters": { "entities": [ { "$ref": "block" } ] } },
				{ "command": "prefab.instantiate", "parameters": { "prefab": "Prefabs/Course/BlockTall.stprefab", "instances": [
					{ "parent": { "$ref": "course" }, "components": { "Transform": { "Translation": [ 0, -4, 0 ] } } },
					{ "parent": { "$ref": "course" }, "components": { "Transform": { "Translation": [ 4, -4, 0 ] } } },
					{ "parent": { "$ref": "course" }, "components": { "Transform": { "Translation": [ 0, -4, -4 ] } } },
					{ "parent": { "$ref": "course" }, "components": { "Transform": { "Translation": [ 4, -4, -4 ] } } },
					{ "parent": { "$ref": "course" }, "components": { "Transform": { "Translation": [ 0, -4, -12 ] } } },
					{ "parent": { "$ref": "course" }, "components": { "Transform": { "Translation": [ 4, -4, -12 ] } } },
					{ "parent": { "$ref": "course" }, "components": { "Transform": { "Translation": [ 0, -4, -28 ] } } },
					{ "parent": { "$ref": "course" }, "components": { "Transform": { "Translation": [ 4, -4, -28 ] } } },
					{ "parent": { "$ref": "course" }, "components": { "Transform": { "Translation": [ 0, 2, -40 ] } } },
					{ "parent": { "$ref": "course" }, "components": { "Transform": { "Translation": [ 4, 2, -40 ] } } } ] },
					"checks": [ { "pointer": "/instances", "length": 10 } ] },
				{ "command": "entity.find", "parameters": { "component": "MeshCollider" }, "checks": [ { "pointer": "/entities", "length": 10 } ] },
				{ "command": "play.start" },
				{ "command": "physics.stats", "expect": { "/waitingForMeshes": { "equals": false } }, "until": { "seconds": 60 },
					"checks": [ { "pointer": "/bodies/static", "equals": 10 } ] },
				{ "command": "play.stop" }
			],
			"endState": true
		},
		{
			"step": 3,
			"files": [
				{ "from": "book:tutorials/make/project-platformer/ThirdPersonPlayer.h", "to": "Scripts/ThirdPersonPlayer.h" },
				{ "from": "book:tutorials/make/project-platformer/ThirdPersonPlayer.step3.cpp", "to": "Scripts/ThirdPersonPlayer.cpp" }
			],
			"commands": [
				{ "command": "inputActions.setMap", "parameters": { "map": "Gameplay" } },
				{ "command": "inputActions.setAction", "parameters": { "action": "Gameplay/Move", "kind": "Vector2", "bindings": [
					"2D:Key/W,Key/S,Key/A,Key/D", "2D:Key/Up,Key/Down,Key/Left,Key/Right", "Gamepad/LeftStick" ] } },
				{ "command": "inputActions.setAction", "parameters": { "action": "Gameplay/Look", "kind": "Vector2", "bindings": [ "Gamepad/RightStick" ] } },
				{ "command": "inputActions.setAction", "parameters": { "action": "Gameplay/Jump", "kind": "Button", "bindings": [ "Key/Space", "Gamepad/A" ] } },
				{ "command": "inputActions.setAction", "parameters": { "action": "Gameplay/Run", "kind": "Button", "bindings": [ "Key/LeftShift", "Gamepad/RightBumper" ] } },
				{ "command": "inputActions.setAction", "parameters": { "action": "Gameplay/Respawn", "kind": "Button", "bindings": [ "Key/R" ] } },
				{ "command": "inputActions.setAction", "parameters": { "action": "Gameplay/Pause", "kind": "Button", "bindings": [ "Key/Escape", "Gamepad/Start" ] } },
				{ "command": "entity.create", "parameters": { "name": "Player", "components": {
					"Transform": { "Translation": [ 2, 0.1, -2 ] },
					"CharacterController": { "Height": 1.8, "Radius": 0.4 },
					"Tag": { "Tag": "Player" } } },
					"bind": { "player": "/id" } },
				{ "command": "selection.set", "parameters": { "entities": [ { "$ref": "player" } ] } },
				{ "command": "camera.focus", "parameters": { "entities": [ { "$ref": "player" } ] } },
				{ "command": "asset.place", "parameters": { "asset": "Models/Robot/RobotExpressive.glb", "point": [ 0, 0, 0 ], "rotation": [ 0, 180, 0 ], "scale": 0.4 },
					"bind": { "robot": "/id" } },
				{ "command": "entity.setParent", "parameters": { "entity": { "$ref": "robot" }, "parent": { "$ref": "player" }, "keepWorldTransform": false } },
				{ "command": "entity.rename", "parameters": { "entity": { "$ref": "robot" }, "name": "Robot" } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "robot" }, "component": "Transform" },
					"checks": [
						{ "pointer": "/values/Translation/0", "approx": 0, "tolerance": 0.01 },
						{ "pointer": "/values/Translation/1", "approx": 0, "tolerance": 0.01 },
						{ "pointer": "/values/Translation/2", "approx": 0, "tolerance": 0.01 },
						{ "pointer": "/values/Scale/0", "approx": 0.4, "tolerance": 0.001 } ] },
				{ "command": "script.build", "expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.add", "parameters": { "entity": { "$ref": "player" }, "class": "ThirdPersonPlayer", "fields": {
					"Robot": { "$ref": "robot" }, "JumpSound": "Sounds/Jump.ogg", "LandSound": "Sounds/Land.ogg" } } },
				{ "command": "script.get", "parameters": { "entity": { "$ref": "player" }, "class": "ThirdPersonPlayer" },
					"checks": [
						{ "pointer": "/scripts/0/fields/WalkSpeed", "approx": 3, "tolerance": 0.001 },
						{ "pointer": "/scripts/0/fields/RunSpeed", "approx": 6.5, "tolerance": 0.001 },
						{ "pointer": "/scripts/0/fields/JumpSpeed", "approx": 5.5, "tolerance": 0.001 } ] },
				{ "command": "play.start" },
				{ "command": "physics.stats", "expect": { "/waitingForMeshes": { "equals": false } }, "until": { "seconds": 60 } },
				{ "command": "input.key", "parameters": { "key": "W", "steps": 60 } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "player" }, "component": "Transform" },
					"expect": { "/values/Translation/2": { "max": -3.5 } },
					"checks": [ { "pointer": "/values/Translation/1", "approx": 0, "tolerance": 0.2 } ] },
				{ "command": "play.stop" }
			],
			"endState": true
		},
		{
			"step": 4,
			"commands": [
				{ "command": "script.build", "files": [ { "from": "book:tutorials/make/project-platformer/FollowCamera.cpp", "to": "Scripts/FollowCamera.cpp" } ],
					"expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "entity.find", "parameters": { "name": "Player" }, "bind": { "player": "/entities/0" } },
				{ "command": "entity.find", "parameters": { "name": "Main Camera" }, "bind": { "camera": "/entities/0" } },
				{ "command": "script.add", "parameters": { "entity": { "$ref": "camera" }, "class": "FollowCamera", "fields": { "Target": { "$ref": "player" } } } },
				{ "command": "play.start" },
				{ "command": "physics.stats", "expect": { "/waitingForMeshes": { "equals": false } }, "until": { "seconds": 60 } },
				{ "command": "script.setField", "parameters": { "entity": { "$ref": "camera" }, "class": "FollowCamera", "field": "Yaw", "value": 90 } },
				{ "command": "input.key", "parameters": { "key": "W", "steps": 60 } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "player" }, "component": "Transform" },
					"expect": { "/values/Translation/0": { "max": 0.5 } },
					"checks": [ { "pointer": "/values/Translation/2", "approx": -2, "tolerance": 0.5 }, { "pointer": "/values/Translation/1", "approx": 0, "tolerance": 0.2 } ] },
				{ "command": "play.stop" }
			],
			"endState": true
		},
		{
			"step": 5,
			"files": [
				{ "from": "book:tutorials/make/project-platformer/ThirdPersonPlayer.step5.cpp", "to": "Scripts/ThirdPersonPlayer.cpp" },
				{ "from": "book:tutorials/make/project-platformer/Footsteps.cpp", "to": "Scripts/Footsteps.cpp" }
			],
			"commands": [
				{ "command": "animation.info", "parameters": { "asset": "Models/Robot/RobotExpressive.glb" },
					"checks": [
						{ "pointer": "/clips/2/name", "equals": "Idle" },
						{ "pointer": "/clips/3/name", "equals": "Jump" },
						{ "pointer": "/clips/6/name", "equals": "Running" },
						{ "pointer": "/clips/11/name", "equals": "Walking" } ],
					"bind": { "idle": "/clips/2/asset", "jump": "/clips/3/asset", "running": "/clips/6/asset", "walking": "/clips/11/asset" } },
				{ "command": "animation.createController", "parameters": { "path": "Animations/Robot.stanimator",
					"parameters": [ { "Name": "Speed", "Type": "Float", "Default": 0 }, { "Name": "Grounded", "Type": "Bool", "Default": true }, { "Name": "Jump", "Type": "Trigger" } ],
					"states": [ { "Name": "Idle", "Clip": { "$ref": "idle" } },
						{ "Name": "Walk", "Clip": { "$ref": "walking" }, "Events": [ { "Name": "Footstep", "Time": 0.02 }, { "Name": "Footstep", "Time": 0.5 } ] },
						{ "Name": "Run", "Clip": { "$ref": "running" }, "Events": [ { "Name": "Footstep", "Time": 0.28 }, { "Name": "Footstep", "Time": 0.76 } ] },
						{ "Name": "Jump", "Clip": { "$ref": "jump" }, "Loop": false } ],
					"transitions": [
						{ "AnyState": true, "CanTransitionToSelf": true, "To": "Jump", "Duration": 0.1, "Conditions": [ { "Parameter": "Jump", "Mode": "Set" } ] },
						{ "From": "Idle", "To": "Walk", "Duration": 0.15, "Conditions": [ { "Parameter": "Speed", "Mode": "Greater", "Threshold": 0.1 } ] },
						{ "From": "Walk", "To": "Idle", "Duration": 0.2, "Conditions": [ { "Parameter": "Speed", "Mode": "Less", "Threshold": 0.1 } ] },
						{ "From": "Walk", "To": "Run", "Duration": 0.2, "Conditions": [ { "Parameter": "Speed", "Mode": "Greater", "Threshold": 4.5 } ] },
						{ "From": "Run", "To": "Walk", "Duration": 0.2, "Conditions": [ { "Parameter": "Speed", "Mode": "Less", "Threshold": 4.5 } ] },
						{ "From": "Jump", "To": "Walk", "Duration": 0.15, "ExitTime": 0.4, "Conditions": [ { "Parameter": "Grounded", "Mode": "True" }, { "Parameter": "Speed", "Mode": "Greater", "Threshold": 0.1 } ] },
						{ "From": "Jump", "To": "Idle", "Duration": 0.2, "ExitTime": 0.4, "Conditions": [ { "Parameter": "Grounded", "Mode": "True" }, { "Parameter": "Speed", "Mode": "Less", "Threshold": 0.1 } ] } ] } },
				{ "command": "animation.info", "parameters": { "asset": "Animations/Robot.stanimator" },
					"checks": [ { "pointer": "/controller/Parameters", "length": 3 }, { "pointer": "/controller/States", "length": 4 }, { "pointer": "/controller/Transitions", "length": 7 } ] },
				{ "command": "component.set", "entityName": "Robot", "parameters": { "component": "Animator", "values": { "Controller": "Animations/Robot.stanimator" } } },
				{ "command": "script.build",
					"expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.build",
					"expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.add", "entityName": "Robot", "parameters": { "class": "Footsteps", "fields": {
					"Step1": "Sounds/Footsteps/Grass1.ogg", "Step2": "Sounds/Footsteps/Grass2.ogg", "Step3": "Sounds/Footsteps/Grass3.ogg", "Step4": "Sounds/Footsteps/Grass4.ogg" } } },
				{ "command": "play.start" },
				{ "command": "physics.stats", "expect": { "/waitingForMeshes": { "equals": false } }, "until": { "seconds": 60 } },
				{ "command": "animation.info", "entityName": "Robot", "checks": [ { "pointer": "/state", "equals": "Idle" } ] },
				{ "command": "play.pause", "parameters": { "paused": true } },
				{ "command": "input.key", "parameters": { "key": "Space" } },
				{ "command": "play.step", "parameters": { "steps": 10 } },
				{ "command": "animation.info", "entityName": "Robot", "checks": [ { "pointer": "/state", "equals": "Jump" } ] },
				{ "command": "play.pause", "parameters": { "paused": false } },
				{ "command": "input.key", "parameters": { "key": "W", "action": "press" } },
				{ "command": "animation.info", "entityName": "Robot", "expect": { "/state": { "equals": "Walk" } }, "until": { "seconds": 5 } },
				{ "command": "script.get", "entityName": "Robot", "parameters": { "class": "Footsteps" },
					"expect": { "/scripts/0/fields/Steps": { "min": 1 } }, "until": { "seconds": 5 } },
				{ "command": "input.key", "parameters": { "key": "LeftShift", "action": "press" } },
				{ "command": "animation.info", "entityName": "Robot", "expect": { "/state": { "equals": "Run" } }, "until": { "seconds": 5 } },
				{ "command": "input.releaseAll" },
				{ "command": "play.stop" }
			],
			"endState": true
		},
		{
			"step": 6,
			"files": [
				{ "from": "book:tutorials/make/project-platformer/CourseState.h", "to": "Scripts/CourseState.h" },
				{ "from": "book:tutorials/make/project-platformer/CourseState.cpp", "to": "Scripts/CourseState.cpp" },
				{ "from": "book:tutorials/make/project-platformer/Coin.cpp", "to": "Scripts/Coin.cpp" },
				{ "from": "book:tutorials/make/project-platformer/Goal.cpp", "to": "Scripts/Goal.cpp" },
				{ "from": "book:tutorials/make/project-platformer/JumpPad.cpp", "to": "Scripts/JumpPad.cpp" },
				{ "from": "book:tutorials/make/project-platformer/ThirdPersonPlayer.cpp", "to": "Scripts/ThirdPersonPlayer.cpp" }
			],
			"commands": [
				{ "command": "ui.create", "parameters": { "type": "canvas", "name": "HUD" }, "bind": { "hud": "/entity" } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "hud" }, "component": "UICanvas", "values": { "ReceivesInput": false } } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "hud" }, "name": "CoinsText", "text": "0 / 8", "anchor": "topLeft", "position": [ 24, 24 ], "size": [ 240, 48 ] },
					"bind": { "coinsText": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "hud" }, "name": "TimeText", "text": "0:00.0", "anchor": "topRight", "position": [ -24, 24 ], "size": [ 240, 48 ] },
					"bind": { "timeText": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "panel", "parent": { "$ref": "hud" }, "name": "Complete", "anchor": "middleCenter", "size": [ 640, 360 ] },
					"bind": { "complete": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "complete" }, "name": "CompleteTime", "text": "Time", "anchor": "topCenter", "position": [ 0, 90 ], "size": [ 600, 60 ] },
					"bind": { "completeTime": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "complete" }, "name": "CompleteBest", "text": "Best", "anchor": "topCenter", "position": [ 0, 170 ], "size": [ 600, 60 ] },
					"bind": { "completeBest": "/entity" } },
				{ "command": "script.build",
					"expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "entity.create", "parameters": { "name": "Game" }, "bind": { "game": "/id" } },
				{ "command": "script.add", "parameters": { "entity": { "$ref": "game" }, "class": "CourseState", "fields": {
					"CoinsText": { "$ref": "coinsText" }, "TimeText": { "$ref": "timeText" }, "CompletePanel": { "$ref": "complete" },
					"CompleteTimeText": { "$ref": "completeTime" }, "CompleteBestText": { "$ref": "completeBest" },
					"CoinSound": "Sounds/Coin.ogg", "CompleteSound": "Sounds/Complete.ogg" } } },
				{ "command": "play.start", "parameters": { "paused": true } },
				{ "command": "play.step", "parameters": { "steps": 2 } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "coinsText" }, "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "0 / 0" } ] },
				{ "command": "play.stop" },
				{ "command": "script.build",
					"expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "entity.create", "parameters": { "name": "Coin", "components": {
					"SphereCollider": { "Radius": 0.7 }, "RigidBody": { "Type": "Static", "IsTrigger": true }, "Tag": { "Tag": "Coin" } } },
					"bind": { "coin": "/id" } },
				{ "command": "asset.place", "parameters": { "asset": "Models/Platformer/coin-gold/coin-gold.glb", "point": [ 0, 0, 0 ] }, "bind": { "coinModel": "/id" } },
				{ "command": "entity.setParent", "parameters": { "entity": { "$ref": "coinModel" }, "parent": { "$ref": "coin" }, "keepWorldTransform": false } },
				{ "command": "script.add", "parameters": { "entity": { "$ref": "coin" }, "class": "Coin" } },
				{ "command": "prefab.create", "parameters": { "entities": [ { "$ref": "coin" } ], "path": "Prefabs/Coin.stprefab" } },
				{ "command": "entity.delete", "parameters": { "entities": [ { "$ref": "coin" } ] } },
				{ "command": "prefab.instantiate", "parameters": { "prefab": "Prefabs/Coin.stprefab", "instances": [
					{ "components": { "Transform": { "Translation": [ 2, 1, 0 ] } } },
					{ "components": { "Transform": { "Translation": [ 0, 1, -12 ] } } },
					{ "components": { "Transform": { "Translation": [ 4, 1, -12 ] } } },
					{ "components": { "Transform": { "Translation": [ 2, 1, -21 ] } } },
					{ "components": { "Transform": { "Translation": [ 0, 1, -28 ] } } },
					{ "components": { "Transform": { "Translation": [ 4, 1, -28 ] } } },
					{ "components": { "Transform": { "Translation": [ 0, 7, -40 ] } } },
					{ "components": { "Transform": { "Translation": [ 4, 7, -40 ] } } } ] },
					"checks": [ { "pointer": "/instances", "length": 8 } ] },
				{ "command": "entity.find", "parameters": { "tag": "Coin" }, "checks": [ { "pointer": "/entities", "length": 8 } ] },
				{ "command": "script.build",
					"expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "entity.create", "parameters": { "name": "JumpPad", "components": {
					"Transform": { "Translation": [ 2, 0, -29 ] },
					"BoxCollider": { "HalfExtents": [ 0.8, 0.5, 0.8 ], "Offset": [ 0, 0.5, 0 ] }, "RigidBody": { "Type": "Static", "IsTrigger": true }, "Tag": { "Tag": "JumpPad" } } },
					"bind": { "pad": "/id" } },
				{ "command": "asset.place", "parameters": { "asset": "Models/Platformer/spring/spring.glb", "point": [ 0, 0, 0 ] }, "bind": { "spring": "/id" } },
				{ "command": "entity.setParent", "parameters": { "entity": { "$ref": "spring" }, "parent": { "$ref": "pad" }, "keepWorldTransform": false } },
				{ "command": "script.add", "parameters": { "entity": { "$ref": "pad" }, "class": "JumpPad", "fields": { "BounceSound": "Sounds/Bounce.ogg" } } },
				{ "command": "prefab.create", "parameters": { "entities": [ { "$ref": "pad" } ], "path": "Prefabs/JumpPad.stprefab" } },
				{ "command": "entity.create", "parameters": { "name": "Checkpoint1", "components": { "Transform": { "Translation": [ 2, 0, -12 ] } } } },
				{ "command": "entity.create", "parameters": { "name": "Checkpoint2", "components": { "Transform": { "Translation": [ 2, 0, -28 ] } } } },
