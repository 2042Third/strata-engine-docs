{
	"page": "make/menus",
	"startsFrom": {
		"tutorial": "make/animation"
	},
	"stages": [
		{
			"step": 1,
			"files": [ { "from": "book:tutorials/make/menus/MainMenu.cpp", "to": "Scripts/MainMenu.cpp" } ],
			"commands": [
				{ "command": "scene.new", "parameters": { "name": "MainMenu" } },
				{ "command": "scene.saveAs", "parameters": { "path": "Scenes/MainMenu.stscene" } },
				{ "command": "ui.create", "parameters": { "type": "canvas", "name": "Menu" }, "bind": { "menu": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "panel", "name": "MenuPanel", "parent": { "$ref": "menu" }, "anchor": "middleCenter", "size": [500, 520] },
					"bind": { "panel": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "verticalLayout", "name": "Column", "parent": { "$ref": "panel" }, "anchor": "stretch", "size": [0, 0] },
					"bind": { "column": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "text", "name": "Title", "parent": { "$ref": "column" }, "text": "Strata Course", "size": [460, 80] } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "Play", "parent": { "$ref": "column" }, "text": "Play", "size": [400, 70] } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "Settings", "parent": { "$ref": "column" }, "text": "Settings", "size": [400, 70] } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "Quit", "parent": { "$ref": "column" }, "text": "Quit", "size": [400, 70] } },
				{ "command": "ui.layout", "parameters": { "entity": { "$ref": "column" } }, "checks": [
					{ "pointer": "/elements/2/name", "equals": "Play" }, { "pointer": "/elements/2/rect/1", "approx": 376, "tolerance": 1 },
					{ "pointer": "/elements/4/name", "equals": "Settings" }, { "pointer": "/elements/4/rect/1", "approx": 454, "tolerance": 1 } ] },
				{ "command": "entity.find", "parameters": { "component": "Camera" }, "checks": [ { "pointer": "/entities", "length": 0 } ] },
				{ "command": "scene.save" },
				{ "command": "script.build",
					"expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "scene.open", "parameters": { "scene": "Scenes/MainMenu.stscene" } },
				{ "command": "entity.find", "parameters": { "name": "Menu" }, "bind": { "menu": "/entities/0" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "entity.find", "parameters": { "name": "Play" }, "bind": { "play": "/entities/0" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "script.add", "parameters": { "entity": { "$ref": "menu" }, "class": "MainMenu",
					"fields": { "Level": "Scenes/Main.stscene", "PlayButton": { "$ref": "play" } } } },
				{ "command": "component.set", "entityName": "Play", "parameters": { "component": "UIButton", "values": { "EventTarget": { "$ref": "menu" } } } },
				{ "command": "component.set", "entityName": "Settings", "parameters": { "component": "UIButton", "values": { "EventTarget": { "$ref": "menu" } } } },
				{ "command": "component.set", "entityName": "Quit", "parameters": { "component": "UIButton", "values": { "EventTarget": { "$ref": "menu" } } } },
				{ "command": "script.get", "parameters": { "entity": { "$ref": "menu" }, "class": "MainMenu" } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 2 }, "expect": { "/stepsRun": { "equals": 2 } } },
				{ "command": "input.click", "parameters": { "entity": { "$ref": "play" }, "wait": false } },
				{ "command": "play.step", "parameters": { "steps": 5 } },
				{ "command": "play.state", "checks": [ { "pointer": "/running/name", "equals": "Main" } ] },
				{ "command": "play.stop" },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 2 }, "expect": { "/stepsRun": { "equals": 2 } } },
				{ "command": "input.click", "entityName": "Quit", "parameters": { "wait": false } },
				{ "command": "play.step", "parameters": { "steps": 3, "wait": false } },
				{ "command": "play.state", "expect": { "/state": { "equals": "Edit" } }, "until": { "seconds": 20 } },
				{ "command": "scene.save" }
			],
			"endState": true
		},
		{
			"step": 2,
			"commands": [
				{ "command": "scene.open", "parameters": { "scene": "Scenes/MainMenu.stscene" } },
				{ "command": "entity.find", "parameters": { "name": "Menu" }, "bind": { "menu": "/entities/0" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "entity.find", "parameters": { "name": "Play" }, "bind": { "play": "/entities/0" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "menu" }, "component": "UICanvas", "values": { "FirstSelected": { "$ref": "play" } } } },
				{ "command": "component.set", "entityName": "Play", "parameters": { "component": "UISelectable", "values": { "FocusedColor": [1, 0.55, 0.1, 1] } } },
				{ "command": "component.set", "entityName": "Settings", "parameters": { "component": "UISelectable", "values": { "FocusedColor": [1, 0.55, 0.1, 1] } } },
				{ "command": "component.set", "entityName": "Quit", "parameters": { "component": "UISelectable", "values": { "FocusedColor": [1, 0.55, 0.1, 1] } } },
				{ "command": "ui.layout", "parameters": { "entity": { "$ref": "play" } } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 2 }, "expect": { "/stepsRun": { "equals": 2 } } },
				{ "command": "ui.layout", "parameters": { "entity": { "$ref": "play" } }, "checks": [ { "pointer": "/elements/0/focused", "equals": true } ] },
				{ "command": "input.key", "parameters": { "key": "Down", "wait": false } },
				{ "command": "play.step", "parameters": { "steps": 3 } },
				{ "command": "ui.layout", "entityName": "Settings", "checks": [ { "pointer": "/elements/0/focused", "equals": true } ] },
				{ "command": "input.key", "parameters": { "key": "Down", "wait": false } },
				{ "command": "play.step", "parameters": { "steps": 3 } },
				{ "command": "ui.layout", "entityName": "Quit", "checks": [ { "pointer": "/elements/0/focused", "equals": true } ] },
				{ "command": "input.key", "parameters": { "key": "Enter", "wait": false } },
				{ "command": "play.step", "parameters": { "steps": 3, "wait": false } },
				{ "command": "play.state", "expect": { "/state": { "equals": "Edit" } }, "until": { "seconds": 20 } },
				{ "command": "scene.save" }
			],
			"endState": true
		},
		{
			"step": 3,
			"files": [ { "from": "book:tutorials/make/menus/PauseMenu.cpp", "to": "Scripts/PauseMenu.cpp" } ],
			"commands": [
				{ "command": "scene.open", "parameters": { "scene": "Scenes/Main.stscene" } },
				{ "command": "inputActions.setAction", "parameters": { "action": "Gameplay/Pause", "kind": "Button", "bindings": [ "Key/Escape", "Gamepad/Start" ] },
					"expect": { "/created": { "equals": true } } },
				{ "command": "ui.create", "parameters": { "type": "canvas", "name": "Pause" }, "bind": { "pause": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "panel", "name": "PausePanel", "parent": { "$ref": "pause" }, "anchor": "stretch", "size": [0, 0] },
					"bind": { "pausePanel": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "text", "name": "PauseTitle", "parent": { "$ref": "pausePanel" }, "text": "Paused",
					"anchor": "topCenter", "position": [0, 120], "size": [600, 100] } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "Resume", "parent": { "$ref": "pausePanel" }, "text": "Resume", "size": [400, 80] },
					"bind": { "resume": "/entity" } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "pause" }, "component": "UICanvas", "values": { "SortOrder": 10 } } },
				{ "command": "script.build", "expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.add", "parameters": { "entity": { "$ref": "pause" }, "class": "PauseMenu",
					"fields": { "Panel": { "$ref": "pausePanel" }, "ResumeButton": { "$ref": "resume" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "resume" }, "component": "UIButton", "values": { "EventTarget": { "$ref": "pause" } } } },
				{ "command": "script.get", "parameters": { "entity": { "$ref": "pause" }, "class": "PauseMenu" } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 2 }, "expect": { "/stepsRun": { "equals": 2 } } },
				{ "command": "ui.layout", "parameters": { "entity": { "$ref": "pausePanel" } }, "checks": [ { "pointer": "/elements/0/visible", "equals": false } ] },
				{ "command": "input.action", "parameters": { "action": "Gameplay/Pause", "steps": 2 } },
				{ "command": "play.step", "parameters": { "steps": 4 } },
				{ "command": "ui.layout", "parameters": { "entity": { "$ref": "pausePanel" } }, "checks": [ { "pointer": "/elements/0/visible", "equals": true }, { "pointer": "/elements/2/name", "equals": "Resume" }, { "pointer": "/elements/2/focused", "equals": true } ] },
				{ "command": "input.key", "parameters": { "key": "Enter", "wait": false } },
				{ "command": "play.step", "parameters": { "steps": 3 } },
				{ "command": "ui.layout", "parameters": { "entity": { "$ref": "pausePanel" } }, "checks": [ { "pointer": "/elements/0/visible", "equals": false } ] },
				{ "command": "play.stop" },
				{ "command": "scene.save" }
			],
			"endState": true
		},
		{
			"step": 4,
			"files": [ { "from": "book:tutorials/make/menus/SettingsMenu.cpp", "to": "Scripts/SettingsMenu.cpp" } ],
			"commands": [
				{ "command": "scene.open", "parameters": { "scene": "Scenes/MainMenu.stscene" } },
				{ "command": "entity.find", "parameters": { "name": "Menu" }, "bind": { "menu": "/entities/0" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "ui.create", "parameters": { "type": "panel", "name": "SettingsPanel", "parent": { "$ref": "menu" }, "anchor": "middleRight", "position": [-40, 0], "size": [560, 640] },
					"bind": { "settings": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "verticalLayout", "name": "SettingsColumn", "parent": { "$ref": "settings" }, "anchor": "stretch", "size": [0, 0] },
					"bind": { "column": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "slider", "name": "Volume", "parent": { "$ref": "column" }, "size": [480, 40] }, "bind": { "volume": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "toggle", "name": "Windowed", "parent": { "$ref": "column" }, "text": "Windowed", "size": [480, 50] }, "bind": { "windowed": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "toggle", "name": "Borderless", "parent": { "$ref": "column" }, "text": "Borderless", "size": [480, 50] }, "bind": { "borderless": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "toggle", "name": "Fullscreen", "parent": { "$ref": "column" }, "text": "Fullscreen", "size": [480, 50] }, "bind": { "fullscreen": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "toggle", "name": "VSync", "parent": { "$ref": "column" }, "text": "VSync", "size": [480, 50] }, "bind": { "vsync": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "Size720", "parent": { "$ref": "column" }, "text": "1280 x 720", "size": [480, 50] }, "bind": { "size720": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "Size1080", "parent": { "$ref": "column" }, "text": "1920 x 1080", "size": [480, 50] }, "bind": { "size1080": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "Size1440", "parent": { "$ref": "column" }, "text": "2560 x 1440", "size": [480, 50] }, "bind": { "size1440": "/entity" } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "windowed" }, "component": "UIToggle", "values": { "Group": { "$ref": "settings" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "borderless" }, "component": "UIToggle", "values": { "Group": { "$ref": "settings" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "fullscreen" }, "component": "UIToggle", "values": { "Group": { "$ref": "settings" } } } },
				{ "command": "prefab.create", "parameters": { "entities": [ { "$ref": "settings" } ], "path": "Prefabs/SettingsPanel.stprefab" },
					"checks": [ { "pointer": "/linked", "equals": true } ] },
				{ "command": "script.build", "expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.add", "parameters": { "entity": { "$ref": "settings" }, "class": "SettingsMenu", "fields": { "VolumeSlider": { "$ref": "volume" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "volume" }, "component": "UISlider", "values": { "EventTarget": { "$ref": "settings" }, "Value": 1 } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "windowed" }, "component": "UIToggle", "values": { "EventTarget": { "$ref": "settings" }, "IsOn": true } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "borderless" }, "component": "UIToggle", "values": { "EventTarget": { "$ref": "settings" }, "IsOn": false } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "fullscreen" }, "component": "UIToggle", "values": { "EventTarget": { "$ref": "settings" }, "IsOn": false } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "vsync" }, "component": "UIToggle", "values": { "EventTarget": { "$ref": "settings" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "size720" }, "component": "UIButton", "values": { "EventTarget": { "$ref": "settings" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "size1080" }, "component": "UIButton", "values": { "EventTarget": { "$ref": "settings" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "size1440" }, "component": "UIButton", "values": { "EventTarget": { "$ref": "settings" } } } },
				{ "command": "ui.layout", "parameters": { "entity": { "$ref": "settings" } }, "checks": [
					{ "pointer": "/elements/6/name", "equals": "Windowed" }, { "pointer": "/elements/6/value", "equals": 1 },
					{ "pointer": "/elements/10/name", "equals": "Borderless" }, { "pointer": "/elements/10/value", "equals": 0 },
					{ "pointer": "/elements/14/name", "equals": "Fullscreen" }, { "pointer": "/elements/14/value", "equals": 0 } ] },
				{ "command": "prefab.apply", "parameters": { "entity": { "$ref": "settings" } } },
				{ "command": "scene.save" },
				{ "command": "scene.open", "parameters": { "scene": "Scenes/Main.stscene" } },
				{ "command": "entity.find", "parameters": { "name": "PausePanel" }, "bind": { "pausePanel": "/entities/0" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "prefab.instantiate", "parameters": { "prefab": "Prefabs/SettingsPanel.stprefab", "parent": { "$ref": "pausePanel" } }, "bind": { "instance": "/id" } },
				{ "command": "script.get", "parameters": { "entity": { "$ref": "instance" }, "class": "SettingsMenu" }, "checks": [ { "pointer": "/scripts", "length": 1 } ] },
				{ "command": "scene.save" },
				{ "command": "scene.open", "parameters": { "scene": "Scenes/MainMenu.stscene" } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 2 }, "expect": { "/stepsRun": { "equals": 2 } } },
				{ "command": "input.click", "parameters": { "entity": { "$ref": "fullscreen" }, "wait": false } },
				{ "command": "play.step", "parameters": { "steps": 3 } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "windowed" }, "component": "UIToggle" },
					"checks": [ { "pointer": "/values/IsOn", "equals": false } ] },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "fullscreen" }, "component": "UIToggle" },
					"checks": [ { "pointer": "/values/IsOn", "equals": true } ] },
				{ "command": "input.click", "parameters": { "entity": { "$ref": "volume" }, "wait": false } },
				{ "command": "play.step", "parameters": { "steps": 3 } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "volume" }, "component": "UISlider" },
					"checks": [ { "pointer": "/values/Value", "approx": 0.5, "tolerance": 0.1 } ] },
				{ "command": "play.stop" },
				{ "command": "scene.save" }
			],
			"endState": true
		},
		{
			"step": 5,
			"files": [ { "from": "book:tutorials/make/menus/RebindMenu.cpp", "to": "Scripts/RebindMenu.cpp" } ],
			"commands": [
				{ "command": "scene.open", "parameters": { "scene": "Scenes/MainMenu.stscene" } },
				{ "command": "inputActions.setAction", "parameters": { "action": "Gameplay/Boost", "kind": "Button", "bindings": [ "Key/LeftShift" ] } },
				{ "command": "entity.find", "parameters": { "name": "Menu" }, "bind": { "menu": "/entities/0" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "ui.create", "parameters": { "type": "panel", "name": "RebindPanel", "parent": { "$ref": "menu" }, "anchor": "middleLeft", "position": [40, 0], "size": [520, 420] },
					"bind": { "panel": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "verticalLayout", "name": "RebindColumn", "parent": { "$ref": "panel" }, "anchor": "stretch", "size": [0, 0] },
					"bind": { "column": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "JumpRow", "parent": { "$ref": "column" }, "text": "Jump", "size": [440, 70] },
					"bind": { "jumpRow": "/entity", "jumpText": "/parts/label" } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "BoostRow", "parent": { "$ref": "column" }, "text": "Boost", "size": [440, 70] },
					"bind": { "boostRow": "/entity", "boostText": "/parts/label" } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "Reset", "parent": { "$ref": "column" }, "text": "Reset", "size": [440, 70] },
					"bind": { "reset": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "button", "name": "Back", "parent": { "$ref": "column" }, "text": "Back", "size": [440, 70] },
					"bind": { "back": "/entity" } },
				{ "command": "script.build", "expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.add", "parameters": { "entity": { "$ref": "panel" }, "class": "RebindMenu", "fields": {
					"Panel": { "$ref": "panel" }, "JumpButton": { "$ref": "jumpRow" }, "JumpText": { "$ref": "jumpText" },
					"BoostButton": { "$ref": "boostRow" }, "BoostText": { "$ref": "boostText" },
					"ResetButton": { "$ref": "reset" }, "BackButton": { "$ref": "back" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "jumpRow" }, "component": "UIButton", "values": { "EventTarget": { "$ref": "panel" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "boostRow" }, "component": "UIButton", "values": { "EventTarget": { "$ref": "panel" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "reset" }, "component": "UIButton", "values": { "EventTarget": { "$ref": "panel" } } } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "back" }, "component": "UIButton", "values": { "EventTarget": { "$ref": "panel" } } } },
				{ "command": "script.get", "parameters": { "entity": { "$ref": "panel" }, "class": "RebindMenu" } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 2 }, "expect": { "/stepsRun": { "equals": 2 } } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "jumpText" }, "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Key/Space, Gamepad/A" } ] },
				{ "command": "input.click", "parameters": { "entity": { "$ref": "jumpRow" }, "wait": false } },
				{ "command": "play.step", "parameters": { "steps": 3 } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "jumpText" }, "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Press a control..." } ] },
				{ "command": "input.key", "parameters": { "key": "K", "wait": false } },
				{ "command": "play.step", "parameters": { "steps": 3 } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "jumpText" }, "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Key/K" } ] },
				{ "command": "play.stop" },
				{ "command": "scene.save" }
			],
			"endState": true
		},
		{
			"step": 6,
			"files": [ { "from": "book:tutorials/make/menus/NameField.cpp", "to": "Scripts/NameField.cpp" } ],
			"commands": [
				{ "command": "scene.open", "parameters": { "scene": "Scenes/Main.stscene" } },
				{ "command": "ui.create", "parameters": { "type": "canvas", "name": "HUD" }, "bind": { "hud": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "inputField", "name": "NameInput", "parent": { "$ref": "hud" }, "text": "Your name",
					"anchor": "topLeft", "position": [24, 24], "size": [400, 60] }, "bind": { "field": "/entity" } },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "field" }, "component": "UIInputField", "values": { "CharacterLimit": 12 } } },
				{ "command": "ui.create", "parameters": { "type": "text", "name": "NameLabel", "parent": { "$ref": "hud" }, "text": "",
					"anchor": "topLeft", "position": [24, 100], "size": [400, 50] }, "bind": { "label": "/entity" } },
				{ "command": "ui.layout", "parameters": { "entity": { "$ref": "field" } } },
