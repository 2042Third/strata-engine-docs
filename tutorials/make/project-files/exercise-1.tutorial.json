{
	"page": "make/project-files",
	"startsFrom": { "template": "basic3d", "name": "CoinRun" },
	"stages": [
		{
			"step": 1,
			"commands": [
				{ "command": "entity.rename", "entityName": "Ground", "parameters": { "name": "Floor" } },
				{ "command": "editor.status", "checks": [ { "pointer": "/scene/modified", "equals": true } ] },
				{ "command": "component.set", "entityName": "Sun", "parameters": { "component": "Transform", "values": { "Translation": [ 0, 10, 0 ] } } },
				{ "command": "project.setSettings", "parameters": { "section": "Scene.Timing", "value": { "FixedRate": "120" } } },
				{ "command": "scene.info", "checks": [ { "pointer": "/settings/fixedRate/stepsPerSecond", "equals": 120 }, { "pointer": "/settings/fixedRate/source", "equals": "project" } ] },
				{ "command": "edit.history", "checks": [ { "pointer": "/history", "length": 3 }, { "pointer": "/history/0", "equals": "Rename 'Ground' to 'Floor'" },
					{ "pointer": "/history/1", "equals": "Set Translation of 'Sun'" }, { "pointer": "/undo", "equals": "Set Timing" } ] },
				{ "command": "edit.undo" },
				{ "command": "edit.undo" },
				{ "command": "edit.undo", "checks": [ { "pointer": "/position", "equals": 0 } ] },
				{ "command": "scene.info", "checks": [ { "pointer": "/settings/fixedRate/source", "equals": "scene" } ] },
				{ "command": "entity.find", "parameters": { "name": "Ground" }, "checks": [ { "pointer": "/entities", "length": 1 } ] }
			]
		}
	]
}
