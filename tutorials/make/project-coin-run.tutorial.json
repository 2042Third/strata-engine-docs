{
	"page": "make/project-coin-run",
	"startsFrom": { "tutorial": "make/export" },
	"stages": [
		{
			"step": 1,
			"commands": [
				{ "command": "entity.find", "parameters": { "name": "Game" }, "bind": { "game": "/entities/0" },
					"checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "entity.get", "parameters": { "entity": { "$ref": "game" } },
					"checks": [ { "pointer": "/parent", "equals": null } ] },
				{ "command": "script.get", "parameters": { "entity": { "$ref": "game" }, "class": "VolumeKeys" },
					"checks": [ { "pointer": "/scripts", "length": 1 } ] },
				{ "command": "script.remove", "entityName": "HUD", "parameters": { "class": "CoinHud" } },
				{ "command": "script.get", "entityName": "HUD",
					"checks": [ { "pointer": "/scripts", "length": 0 } ] },
				{ "command": "scene.save" },
				{ "command": "script.create", "parameters": { "class": "CoinRunGame" } },
				{ "command": "script.build", "files": [ { "from": "book:tutorials/make/project-coin-run/CoinRunGame.step1.cpp", "to": "Scripts/CoinRunGame.cpp" } ],
					"expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.add", "entityName": "Game", "parameters": { "class": "CoinRunGame", "fields": { "TimeLimit": 40 } } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 90 }, "expect": { "/stepsRun": { "equals": 90 } } },
				{ "command": "entity.find", "parameters": { "tag": "Coin" }, "checks": [ { "pointer": "/entities", "length": 5 } ] },
				{ "command": "component.get", "entityName": "CoinText", "parameters": { "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Coins left: 5" } ] },
				{ "command": "component.get", "entityName": "TimerText", "parameters": { "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Time: 39" } ] },
				{ "command": "component.get", "entityName": "TimeBar", "parameters": { "component": "UIImage" },
					"checks": [ { "pointer": "/values/FillAmount", "approx": 0.9625, "tolerance": 0.005 } ] },
				{ "command": "entity.find", "parameters": { "tag": "Coin" }, "bind": { "coins": "/entities" },
					"checks": [ { "pointer": "/entities", "length": 5 } ] },
				{ "command": "entity.delete", "parameters": { "entities": { "$ref": "coins" } } },
				{ "command": "play.step", "parameters": { "steps": 2 }, "expect": { "/stepsRun": { "equals": 2 } } },
				{ "command": "log.read", "parameters": { "newest": true, "limit": 20 },
					"checks": [ { "pointer": "/messages", "contains": "Round won" } ] },
				{ "command": "play.stop" },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 2490 }, "expect": { "/stepsRun": { "equals": 2490 } } },
				{ "command": "component.get", "entityName": "TimerText", "parameters": { "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Time: 0" } ] },
				{ "command": "log.read", "parameters": { "newest": true, "limit": 50 },
					"checks": [ { "pointer": "/messages", "contains": "Round lost" } ] },
				{ "command": "play.stop" }
			],
			"endState": true
		},
		{
			"step": 2,
			"commands": [
				{ "command": "asset.import", "parameters": { "file": "@RELEASE@/Samples/ThirdPerson/Assets/Sounds/Complete.ogg", "directory": "Sounds" } },
				{ "command": "asset.info", "parameters": { "asset": "Sounds/Complete.ogg" }, "until": { "seconds": 60 },
					"expect": { "/importing": { "equals": false } } },
				{ "command": "entity.find", "parameters": { "name": "HUD" }, "bind": { "hud": "/entities/0" } },
				{ "command": "ui.create", "parameters": { "type": "panel", "parent": { "$ref": "hud" }, "name": "WinPanel", "anchor": "middleCenter", "size": [700, 300] },
					"bind": { "winpanel": "/entity" } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "winpanel" }, "name": "WinTitle", "text": "You win", "anchor": "middleCenter", "size": [660, 100] } },
				{ "command": "component.set", "entityName": "WinTitle", "parameters": { "component": "UIText", "values": { "FontSize": 72 } } },
				{ "command": "ui.create", "parameters": { "type": "text", "parent": { "$ref": "winpanel" }, "name": "WinHint", "text": "Press Enter to play again", "anchor": "bottomCenter", "position": [0, -24], "size": [660, 60] } },
				{ "command": "component.set", "entityName": "WinHint", "parameters": { "component": "UIText", "values": { "FontSize": 36 } } },
				{ "command": "entity.get", "entityName": "WinPanel",
					"checks": [ { "pointer": "/children", "length": 2 } ] },
				{ "command": "entity.duplicate", "entityName": "WinPanel" },
				{ "command": "entity.rename", "entityName": "WinPanel (1)", "parameters": { "name": "LosePanel" } },
				{ "command": "entity.get", "entityName": "LosePanel", "bind": { "losetitle": "/children/0" },
					"checks": [ { "pointer": "/children", "length": 2 } ] },
				{ "command": "component.set", "parameters": { "entity": { "$ref": "losetitle" }, "component": "UIText", "values": { "Text": "Time's up" } } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "losetitle" }, "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Time's up" }, { "pointer": "/values/FontSize", "approx": 72, "tolerance": 0.001 } ] },
				{ "command": "entity.find", "parameters": { "name": "WinPanel" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "inputActions.setAction", "parameters": { "action": "Gameplay/Restart", "kind": "Button", "bindings": [ "Key/Enter", "Gamepad/Start" ] } },
				{ "command": "scene.save" },
				{ "command": "script.build", "files": [ { "from": "book:tutorials/make/project-coin-run/CoinRunGame.step2.cpp", "to": "Scripts/CoinRunGame.cpp" } ],
					"expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 120 }, "expect": { "/stepsRun": { "equals": 120 } } },
				{ "command": "entity.get", "entityName": "WinPanel", "checks": [ { "pointer": "/active", "equals": false } ] },
				{ "command": "entity.find", "parameters": { "tag": "Coin" }, "bind": { "coins": "/entities" },
					"checks": [ { "pointer": "/entities", "length": 5 } ] },
				{ "command": "entity.delete", "parameters": { "entities": { "$ref": "coins" } } },
				{ "command": "play.step", "parameters": { "steps": 2 }, "expect": { "/stepsRun": { "equals": 2 } } },
				{ "command": "entity.get", "entityName": "WinPanel", "checks": [ { "pointer": "/active", "equals": true } ] },
				{ "command": "component.get", "entityName": "CoinText", "parameters": { "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Coins left: 0" } ] },
				{ "command": "input.key", "parameters": { "key": "Enter" } },
				{ "command": "play.step", "parameters": { "steps": 120 }, "expect": { "/stepsRun": { "equals": 120 } } },
				{ "command": "entity.get", "entityName": "WinPanel", "checks": [ { "pointer": "/active", "equals": false } ] },
				{ "command": "entity.find", "parameters": { "tag": "Coin" }, "checks": [ { "pointer": "/entities", "length": 5 } ] },
				{ "command": "play.stop" },
				{ "command": "script.setField", "entityName": "Game", "parameters": { "class": "CoinRunGame", "field": "TimeLimit", "value": 8 } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 1 }, "expect": { "/stepsRun": { "equals": 1 } } },
				{ "command": "entity.get", "entityName": "WinPanel", "checks": [ { "pointer": "/active", "equals": false } ] },
				{ "command": "entity.get", "entityName": "LosePanel", "checks": [ { "pointer": "/active", "equals": false } ] },
				{ "command": "play.step", "parameters": { "steps": 600 }, "expect": { "/stepsRun": { "equals": 600 } } },
				{ "command": "entity.get", "entityName": "LosePanel", "checks": [ { "pointer": "/active", "equals": true } ] },
				{ "command": "entity.get", "entityName": "WinPanel", "checks": [ { "pointer": "/active", "equals": false } ] },
				{ "command": "component.get", "entityName": "TimerText", "parameters": { "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Time: 0" } ] },
				{ "command": "input.key", "parameters": { "key": "Enter" } },
				{ "command": "play.step", "parameters": { "steps": 10 }, "expect": { "/stepsRun": { "equals": 10 } } },
				{ "command": "entity.get", "entityName": "LosePanel", "checks": [ { "pointer": "/active", "equals": false } ] },
				{ "command": "component.get", "entityName": "TimerText", "parameters": { "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Time: 8" } ] },
				{ "command": "play.stop" },
				{ "command": "script.setField", "entityName": "Game", "parameters": { "class": "CoinRunGame", "field": "TimeLimit", "value": 40 } },
				{ "command": "script.get", "entityName": "Game", "parameters": { "class": "CoinRunGame" },
					"checks": [ { "pointer": "/scripts/0/fields/TimeLimit", "approx": 40, "tolerance": 0.001 } ] }
			],
			"endState": true
		},
		{
			"step": 3,
			"commands": [
				{ "command": "component.set", "entityName": "Main Camera", "parameters": { "component": "Transform", "values": { "Translation": [0, 16, 13], "Rotation": [-0.4617, 0, 0, 0.887] } } },
				{ "command": "scene.save" },
				{ "command": "script.build", "files": [ { "from": "book:tutorials/make/project-coin-run/CoinRunGame.cpp", "to": "Scripts/CoinRunGame.cpp" } ],
					"expect": { "/success": { "equals": true } }, "checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.get", "entityName": "Game", "parameters": { "class": "CoinRunGame" },
					"checks": [
						{ "pointer": "/scripts/0/fields/Difficulty", "equals": 1 },
						{ "pointer": "/scripts/0/fields/TimeLimit", "approx": 40, "tolerance": 0.001 }
					] },
				{ "command": "script.setField", "entityName": "Game", "parameters": { "class": "CoinRunGame", "field": "Difficulty", "value": 0 } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 30 }, "expect": { "/stepsRun": { "equals": 30 } } },
				{ "command": "component.get", "entityName": "TimerText", "parameters": { "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Time: 60" } ] },
				{ "command": "play.stop" },
				{ "command": "script.setField", "entityName": "Game", "parameters": { "class": "CoinRunGame", "field": "Difficulty", "value": 2 } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 30 }, "expect": { "/stepsRun": { "equals": 30 } } },
				{ "command": "component.get", "entityName": "TimerText", "parameters": { "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Time: 27" } ] },
				{ "command": "play.step", "parameters": { "steps": 420 }, "expect": { "/stepsRun": { "equals": 420 } } },
				{ "command": "component.get", "entityName": "TimerText", "parameters": { "component": "UIText" },
					"checks": [
						{ "pointer": "/values/Text", "equals": "Time: 20" },
						{ "pointer": "/values/Color/2", "approx": 0.2, "tolerance": 0.001 }
					] },
				{ "command": "play.stop" },
				{ "command": "script.setField", "entityName": "Game", "parameters": { "class": "CoinRunGame", "field": "Difficulty", "value": 1 } },
				{ "command": "prefab.instantiate", "parameters": { "prefab": "Prefabs/Coin.stprefab", "components": { "Transform": { "Translation": [0, 0.8, 6] } } },
					"bind": { "tuned": "/id" } },
				{ "command": "script.setField", "parameters": { "entity": { "$ref": "tuned" }, "class": "Coin", "field": "DegreesPerSecond", "value": 90 } },
				{ "command": "script.setField", "parameters": { "entity": { "$ref": "tuned" }, "class": "Coin", "field": "BobHeight", "value": 0.25 } },
				{ "command": "prefab.apply", "parameters": { "entity": { "$ref": "tuned" } } },
				{ "command": "entity.delete", "parameters": { "entities": [ { "$ref": "tuned" } ] }, "checks": [ { "pointer": "/deleted", "length": 1 }, { "pointer": "/count", "equals": 2 } ] },
				{ "command": "entity.find", "parameters": { "tag": "Coin" }, "checks": [ { "pointer": "/entities", "length": 0 } ] },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 120 }, "expect": { "/stepsRun": { "equals": 120 } } },
				{ "command": "entity.find", "parameters": { "tag": "Coin" }, "bind": { "coin": "/entities/0" },
					"checks": [ { "pointer": "/entities", "length": 5 } ] },
				{ "command": "script.get", "parameters": { "entity": { "$ref": "coin" }, "class": "Coin" },
					"checks": [
						{ "pointer": "/scripts/0/fields/DegreesPerSecond", "approx": 90, "tolerance": 0.001 },
						{ "pointer": "/scripts/0/fields/BobHeight", "approx": 0.25, "tolerance": 0.001 }
					] },
				{ "command": "component.get", "entityName": "CoinText", "parameters": { "component": "UIText" },
					"checks": [ { "pointer": "/values/Text", "equals": "Coins left: 5" } ] },
				{ "command": "log.read", "parameters": { "newest": true, "limit": 50 } },
				{ "command": "play.stop" },
				{ "command": "script.remove", "entityName": "Ball", "parameters": { "class": "BallControl" } },
				{ "command": "script.add", "entityName": "Ball", "parameters": { "class": "BallControl" } },
				{ "command": "script.get", "entityName": "Ball", "parameters": { "class": "BallControl" },
					"checks": [ { "pointer": "/scripts/0/fields/PushStrength", "approx": 12, "tolerance": 0.001 } ] },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 10 }, "expect": { "/stepsRun": { "equals": 10 } } },
				{ "command": "log.read", "parameters": { "newest": true, "limit": 20 } },
				{ "command": "play.stop" }
			],
			"endState": true
		},
		{
			"step": 4,
			"commands": [
				{ "command": "project.info",
					"checks": [
						{ "pointer": "/game/title", "equals": "Coin Run" },
						{ "pointer": "/game/version", "equals": "1.0.0" }
					] },
				{ "command": "project.setExportSettings", "parameters": { "alwaysInclude": [ "Prefabs", "Materials/GoldGlow.stmat", "Sounds" ] },
					"checks": [ { "pointer": "/alwaysInclude", "equals": [ "Prefabs", "Materials/GoldGlow.stmat", "Sounds" ] } ] },
				{ "command": "scene.save" },
				{ "command": "script.build", "expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] }
			],
			"endState": true
		}
	]
}
