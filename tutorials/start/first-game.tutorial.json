{
	"page": "start/first-game",
	"startsFrom": { "template": "basic3d", "name": "FirstGame" },
	"stages": [
		{
			"step": 1,
			"endState": true
		},
		{
			"step": 2,
			"endState": true,
			"commands": [
				{ "command": "entity.find", "parameters": { "name": "Main Camera" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "entity.find", "parameters": { "name": "Sun" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "entity.find", "parameters": { "name": "Sky" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "entity.find", "parameters": { "name": "Ground" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "entity.find", "parameters": { "name": "Post Process" }, "checks": [ { "pointer": "/entities", "length": 1 } ] },
				{ "command": "component.get", "entityName": "Ground", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Scale/0", "approx": 20, "tolerance": 0.001 }, { "pointer": "/values/Scale/2", "approx": 20, "tolerance": 0.001 }, { "pointer": "/values/Translation/1", "approx": 0, "tolerance": 0.001 } ] },
				{ "command": "component.get", "entityName": "Ground", "parameters": { "component": "BoxCollider" },
					"checks": [ { "pointer": "/values/HalfExtents/1", "approx": 0.5, "tolerance": 0.001 }, { "pointer": "/values/Offset/1", "approx": -0.5, "tolerance": 0.001 } ] },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 30 }, "expect": { "/stepsRun": { "equals": 30 } } },
				{ "command": "play.stop" }
			]
		},
		{
			"step": 3,
			"endState": true,
			"commands": [
				{ "command": "entity.create", "bind": { "cube": "/id" },
					"parameters": { "name": "Cube", "components": { "MeshRenderer": { "Mesh": "Builtin/Cube" }, "BoxCollider": { "HalfExtents": [0.5, 0.5, 0.5] }, "Transform": { "Translation": [-0.5, 0.5, 0] } } } },
				{ "command": "entity.get", "entityName": "Cube",
					"checks": [ { "pointer": "/components", "length": 4 }, { "pointer": "/components/MeshRenderer/Mesh", "equals": "0000000000000001" }, { "pointer": "/components/BoxCollider/HalfExtents/0", "approx": 0.5, "tolerance": 0.001 } ] },
				{ "command": "component.set", "entityName": "Cube",
					"parameters": { "component": "Transform", "values": { "Translation": [-0.5, 3, 0], "Rotation": [0, 30, 0], "Scale": [1, 2, 1] } } },
				{ "command": "component.set", "entityName": "Cube",
					"parameters": { "component": "Transform", "values": { "Translation": [-0.5, 3, 0], "Rotation": [0, 0, 0], "Scale": [1, 1, 1] } } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 30 }, "expect": { "/stepsRun": { "equals": 30 } } },
				{ "command": "component.get", "entityName": "Cube", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Translation/1", "approx": 3, "tolerance": 0.001 } ] },
				{ "command": "play.stop" },
				{ "command": "scene.save" }
			]
		},
		{
			"step": 4,
			"endState": true,
			"commands": [
				{ "command": "component.add", "entityName": "Cube", "parameters": { "component": "RigidBody" } },
				{ "command": "component.get", "entityName": "Cube", "parameters": { "component": "RigidBody" },
					"checks": [ { "pointer": "/values/Type", "equals": "Dynamic" } ] },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 180 }, "expect": { "/stepsRun": { "equals": 180 } } },
				{ "command": "component.get", "entityName": "Cube", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Translation/0", "approx": -0.5, "tolerance": 0.01 }, { "pointer": "/values/Translation/1", "approx": 0.5, "tolerance": 0.01 } ] },
				{ "command": "play.stop" },
				{ "command": "component.get", "entityName": "Cube", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Translation/1", "approx": 3, "tolerance": 0.001 } ] },
				{ "command": "entity.create",
					"parameters": { "name": "Ramp", "components": { "MeshRenderer": { "Mesh": "Builtin/Cube" }, "BoxCollider": { "HalfExtents": [0.5, 0.5, 0.5] }, "Transform": { "Translation": [0, 0.8, 0], "Rotation": [0, 0, -35], "Scale": [3, 0.2, 2] } } } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 60 }, "expect": { "/stepsRun": { "equals": 60 } } },
				{ "command": "component.get", "entityName": "Cube", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Translation/0", "approx": 0.65, "tolerance": 0.1 }, { "pointer": "/values/Translation/1", "approx": 1.08, "tolerance": 0.1 } ] },
				{ "command": "play.step", "parameters": { "steps": 240 }, "expect": { "/stepsRun": { "equals": 240 } } },
				{ "command": "component.get", "entityName": "Cube", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Translation/0", "approx": 1.91, "tolerance": 0.1 }, { "pointer": "/values/Translation/1", "approx": 0.5, "tolerance": 0.01 } ] },
				{ "command": "play.stop" },
				{ "command": "component.set", "entityName": "Cube",
					"parameters": { "component": "RigidBody", "values": { "Friction": 0.05, "Restitution": 0.7 } } },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 60 }, "expect": { "/stepsRun": { "equals": 60 } } },
				{ "command": "component.get", "entityName": "Cube", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Translation/0", "approx": 1.17, "tolerance": 0.1 }, { "pointer": "/values/Translation/1", "approx": 0.82, "tolerance": 0.1 } ] },
				{ "command": "play.step", "parameters": { "steps": 240 }, "expect": { "/stepsRun": { "equals": 240 } } },
				{ "command": "component.get", "entityName": "Cube", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Translation/0", "approx": 8.6, "tolerance": 0.3 }, { "pointer": "/values/Translation/1", "approx": 0.5, "tolerance": 0.01 } ] },
				{ "command": "play.stop" },
				{ "command": "scene.save" }
			]
		},
		{
			"step": 5,
			"commands": [
				{ "command": "entity.create",
					"parameters": { "name": "Top", "components": { "MeshRenderer": { "Mesh": "Builtin/Cube" }, "BoxCollider": { "HalfExtents": [0.5, 0.5, 0.5] }, "Transform": { "Translation": [-3, 2, 0] } } } },
				{ "command": "script.build", "expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.add", "entityName": "Top", "parameters": { "class": "Spinner" } },
				{ "command": "script.get", "entityName": "Top", "parameters": { "class": "Spinner" },
					"checks": [ { "pointer": "/scripts/0/fields/DegreesPerSecond", "equals": 90 } ] },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 60 }, "expect": { "/stepsRun": { "equals": 60 } } },
				{ "command": "component.get", "entityName": "Top", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Rotation/1", "approx": 0.7071, "tolerance": 0.01 }, { "pointer": "/values/Rotation/3", "approx": 0.7071, "tolerance": 0.01 } ] },
				{ "command": "play.stop" },
				{ "command": "scene.save" },
				{ "command": "script.build", "files": [ { "from": "book:tutorials/start/first-game/Spinner-360.cpp", "to": "Scripts/Spinner.cpp" } ],
					"expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 30 }, "expect": { "/stepsRun": { "equals": 30 } } },
				{ "command": "component.get", "entityName": "Top", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Rotation/1", "approx": 1, "tolerance": 0.02 } ] },
				{ "command": "play.stop" },
				{ "command": "scene.save" },
				{ "command": "script.build", "files": [ { "from": "book:tutorials/start/first-game/Spinner.cpp", "to": "Scripts/Spinner.cpp" } ],
					"expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "play.start", "parameters": { "paused": true, "build": false } },
				{ "command": "play.step", "parameters": { "steps": 30 }, "expect": { "/stepsRun": { "equals": 30 } } },
				{ "command": "component.get", "entityName": "Top", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Rotation/1", "approx": 1, "tolerance": 0.02 } ] },
				{ "command": "log.read", "parameters": { "logger": "Script", "newest": true, "limit": 5 },
					"checks": [ { "pointer": "/messages", "contains": "Spinner starts with 360 degrees per second" } ] },
				{ "command": "play.stop" },
				{ "command": "scene.save" }
			],
			"endState": true
		}
	]
}
