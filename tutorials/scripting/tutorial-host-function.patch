+++ b/StrataTests/src/Scripting/ScriptWindEventTests.cpp
@@ -0,0 +1,48 @@
+#include <doctest/doctest.h>
+
+#include "Scripting/ScriptTestUtils.h"
+#include "Strata/Physics/PhysicsComponents.h"
+#include "TestHelpers.h"
+
+using namespace Strata;
+using namespace Strata::Tests;
+
+TEST_SUITE("Scripting.Wind")
+{
+#if ST_WITH_PHYSICS
+	TEST_CASE("OnWindChanged reaches the scripts of the zone's entity once for each change")
+	{
+		ScopedScriptEngine engine(GetTestScriptModule(STRATA_TEST_SCRIPTS_API));
+		Scene scene;
+		Entity gust = scene.CreateEntity("Gust");
+		gust.AddComponent<WindZoneComponent>().Strength = 25.0f;
+		AddScriptEntry(gust, "WindEventProbe");
+		scene.OnRuntimeStart();
+		ScriptSystem& system = GetScriptSystem(scene);
+
+		RunFrames(scene, 5);
+		CHECK(GetField<int32_t>(system, gust, "WindEventProbe", "Changes") == 0);
+
+		gust.GetComponent<WindZoneComponent>().Strength = 40.0f;
+		RunFrames(scene, 5);
+		CHECK(GetField<int32_t>(system, gust, "WindEventProbe", "Changes") == 1);
+		CHECK(GetField<float>(system, gust, "WindEventProbe", "LastChange") == doctest::Approx(40.0f));
+		scene.OnRuntimeStop();
+	}
+#endif
+
+	TEST_CASE("OnWindChanged is read only from class descriptors large enough to hold it")
+	{
+		// "First" has the descriptor size of an SDK that has the UI callbacks but predates OnWindChanged.
+		ScopedEnvironmentVariable scopedCase("STRATA_TEST_MALFORMED_CASE", "OlderWindClass");
+		ScopedScriptEngine engine(GetTestScriptModule(STRATA_TEST_SCRIPTS_MALFORMED));
+		const ScriptClassInfo* first = engine->FindClass("First");
+		const ScriptClassInfo* second = engine->FindClass("Second");
+		REQUIRE(first);
+		REQUIRE(second);
+		CHECK(first->Implements(ScriptCallback::OnUISubmit));
+		CHECK_FALSE(first->Implements(ScriptCallback::OnWindChanged));
+		CHECK(second->Implements(ScriptCallback::OnWindChanged));
+		CHECK_FALSE(engine->IsFaulted());
+	}
+}
