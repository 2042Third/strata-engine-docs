@@ -0,0 +1,57 @@
+// Wind: Wind::GetStrength and Script::OnWindChanged, on "Gust", the feature scene's wind zone.
+
+#include "FeatureScript.h"
+
+using namespace Strata;
+using namespace FeatureTest;
+
+// Raises its zone's strength from 25 to 40 newtons at frame 10, hears of it once, and reads the wind at the zone's center
+// and far outside every zone.
+class WindEventFeatures : public FeatureScript
+{
+public:
+	static constexpr int32_t c_RaiseFrame = 10;
+	static constexpr int32_t c_CheckFrame = 20;
+
+	int32_t Changes = 0;     // OnWindChanged calls
+	float LastChange = 0.0f; // The strength the latest one carried
+
+	void OnCreate() override
+	{
+		Journal(*this, "WindEventFeatures", "OnCreate");
+	}
+
+	void OnUpdate(float) override
+	{
+		if (GetFrame() == c_RaiseFrame)
+			Expect(GetEntity().SetProperty("WindZone", "Strength", 40.0f), "the zone's strength is written");
+	}
+
+	void OnWindChanged(float strength) override
+	{
+		Changes++;
+		LastChange = strength;
+		if (Changes == 1)
+			Journal(*this, "WindEventFeatures", "OnWindChanged");
+	}
+
+	void OnLateUpdate(float) override
+	{
+		if (GetFrame() != c_CheckFrame)
+			return;
+		Expect(Changes == 1, "the change reached OnWindChanged once");
+		Expect(Near(LastChange, 40.0f), "OnWindChanged carries the new strength");
+		Expect(Near(Wind::GetStrength(GetTransform().GetWorldPosition()), 40.0f), "the wind at the zone's center is its strength");
+		Expect(Wind::GetStrength(glm::vec3(1000.0f, 0.0f, 0.0f)) == 0.0f, "no wind outside every zone");
+		Completed = true;
+	}
+};
+
+ST_SCRIPT_CLASS(WindEventFeatures)
+{
+	ST_SCRIPT_FIELD(Checks);
+	ST_SCRIPT_FIELD(Failure);
+	ST_SCRIPT_FIELD(Completed);
+	ST_SCRIPT_FIELD(Changes);
+	ST_SCRIPT_FIELD(LastChange);
+}
