+		CHECK(reader.NextLine().value() == "{\"a\":1}");
+		CHECK_FALSE(reader.NextLine().has_value());
+		reader.Append(std::string_view("{\"b\":2}\n"));
+		CHECK(reader.NextLine().value() == "{\"b\":2}");
