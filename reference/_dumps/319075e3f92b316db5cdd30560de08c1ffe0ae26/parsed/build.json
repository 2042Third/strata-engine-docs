				"Suites": [
					"Asset*"
				]
			},
			{
				"Name": "Scene",
				"Suites": [
					"Scene*",
					"Project*",
					"Animation*"
				],
				"Exclude": [
					"Scene.Timing*"
				]
			},
			{
				"Name": "SceneTiming",
				"Suites": [
					"Scene.Timing*"
				]
			},
			{
				"Name": "Systems",
				"Suites": [
					"Physics*",
					"Audio*",
					"Scripting*",
					"World*"
				],
				"Exclude": [
					"Scripting.LoaderFaults",
					"Physics.Settling"
				]
			},
			{
