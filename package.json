{
	"name": "strata-engine-docs",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"description": "The Strata Engine Book: how a game engine works, and how to make games with one.",
	"engines": {
		"node": "26.13.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "node --max-old-space-size=4096 node_modules/astro/bin/astro.mjs build",
		"test": "node --test src/plugins/tests/",
		"lint:md": "markdownlint-cli2",
		"check:a11y": "node scripts/a11y.mjs",
		"check:keyboard": "node scripts/keyboard.mjs",
		"check:lighthouse": "node scripts/lighthouse.mjs",
		"check:runtime": "node scripts/runtime.mjs",
		"preview": "node scripts/serve.mjs",
		"check:search": "node scripts/search-payload.mjs",
		"check:search-quality": "node scripts/search-quality.mjs",
		"diagrams": "node scripts/diagrams.mjs",
		"check:diagrams": "node scripts/diagram-checks.mjs",
		"drawings": "node scripts/drawings.mjs",
		"placeholders": "node scripts/placeholders.mjs",
		"scale": "node scripts/scale.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.6",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/starlight": "0.42.10",
		"@expressive-code/plugin-collapsible-sections": "0.44.3",
		"@expressive-code/plugin-line-numbers": "0.44.3",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/source-serif-4": "5.3.1",
		"astro": "7.4.8",
		"github-slugger": "2.0.0",
		"hast-util-from-html": "2.1.0",
		"hast-util-to-html": "9.0.6",
		"katex": "0.16.47",
		"mermaid-isomorphic": "3.1.0",
		"pagefind": "1.6.0",
		"playwright": "1.65.0",
		"rehype-katex": "7.0.1",
		"remark-directive": "4.0.0",
		"remark-gfm": "4.0.1",
		"remark-math": "6.0.0",
		"remark-parse": "11.0.0",
		"remark-smartypants": "3.0.3",
		"sharp": "0.35.5",
		"unified": "11.0.5",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"lighthouse": "13.6.0",
		"markdownlint-cli2": "0.24.0",
		"remark-rehype": "11.1.2",
		"vfile": "6.0.3"
	},
	"overrides": {
		"mermaid": "11.17.2",
		"katex": "0.16.47"
	}
}
