					0.6,
					2.6,
					6.8
				],
				"target": [
					0,
					2.4,
					-8
				],
				"fov": 55
			},
			"size": [
				1280,
				720
			],
			"quality": "high",
			"setup": [
				{
					"command": "entity.setActive",
					"entityName": "HUD",
					"parameters": {
						"active": false
					}
				},
				{
					"command": "entity.setActive",
					"entityName": "Menus",
					"parameters": {
						"active": false
					}
				},
				{
					"command": "asset.setImportSettings",
					"parameters": {
						"asset": "A76F8BB1E806ACFF",
						"settings": {
							"RemoveSun": true
						}
					}
				}
			],
			"variants": {
