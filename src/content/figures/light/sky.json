								}
							}
						}
					]
				},
				"procedural": {
					"setup": [
						{
							"command": "component.set",
							"entityName": "Sky",
							"parameters": {
								"component": "SkyLight",
								"values": {
									"Source": "Procedural"
								}
							}
						}
					]
				},
				"atmosphere": {
					"setup": [
						{
							"command": "component.set",
							"entityName": "Sky",
							"parameters": {
