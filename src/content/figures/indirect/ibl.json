						{ "command": "component.remove", "entityName": "Sky", "parameters": { "component": "SkyLight" } },
						{ "command": "material.create", "parameters": { "path": "Materials/AmbientWhite.stmat", "properties": { "BaseColor": [0.9, 0.9, 0.9, 1.0], "Roughness": 0.6 } } },
						{ "command": "entity.create", "parameters": { "name": "White", "components": { "MeshRenderer": { "Mesh": "Builtin/Sphere", "Material": "Materials/AmbientWhite.stmat" }, "Transform": { "Translation": [-2.2, 0.5, 0] } } } },
						{ "command": "material.create", "parameters": { "path": "Materials/AmbientRoughMetal.stmat", "properties": { "BaseColor": [0.9, 0.9, 0.9, 1.0], "Metallic": 1.0, "Roughness": 0.6 } } },
						{ "command": "entity.create", "parameters": { "name": "RoughMetal", "components": { "MeshRenderer": { "Mesh": "Builtin/Sphere", "Material": "Materials/AmbientRoughMetal.stmat" }, "Transform": { "Translation": [0.0, 0.5, 0] } } } },
						{ "command": "material.create", "parameters": { "path": "Materials/AmbientSmoothMetal.stmat", "properties": { "BaseColor": [0.9, 0.9, 0.9, 1.0], "Metallic": 1.0, "Roughness": 0.05 } } },
						{ "command": "entity.create", "parameters": { "name": "SmoothMetal", "components": { "MeshRenderer": { "Mesh": "Builtin/Sphere", "Material": "Materials/AmbientSmoothMetal.stmat" }, "Transform": { "Translation": [2.2, 0.5, 0] } } } }
