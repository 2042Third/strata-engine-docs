						{ "command": "material.create", "parameters": { "path": "Materials/AtmosphereWhite.stmat", "properties": { "BaseColor": [0.9, 0.9, 0.9, 1.0], "Roughness": 0.6 } } },
						{ "command": "entity.create", "parameters": { "name": "White", "components": { "MeshRenderer": { "Mesh": "Builtin/Sphere", "Material": "Materials/AtmosphereWhite.stmat" }, "Transform": { "Translation": [-2.2, 0.5, 0] } } } },
						{ "command": "material.create", "parameters": { "path": "Materials/AtmosphereRoughMetal.stmat", "properties": { "BaseColor": [0.9, 0.9, 0.9, 1.0], "Metallic": 1.0, "Roughness": 0.6 } } },
						{ "command": "entity.create", "parameters": { "name": "RoughMetal", "components": { "MeshRenderer": { "Mesh": "Builtin/Sphere", "Material": "Materials/AtmosphereRoughMetal.stmat" }, "Transform": { "Translation": [0.0, 0.5, 0] } } } },
						{ "command": "material.create", "parameters": { "path": "Materials/AtmosphereSmoothMetal.stmat", "properties": { "BaseColor": [0.9, 0.9, 0.9, 1.0], "Metallic": 1.0, "Roughness": 0.05 } } },
						{ "command": "entity.create", "parameters": { "name": "SmoothMetal", "components": { "MeshRenderer": { "Mesh": "Builtin/Sphere", "Material": "Materials/AtmosphereSmoothMetal.stmat" }, "Transform": { "Translation": [2.2, 0.5, 0] } } } }
					]
				},
				"ambient": {
