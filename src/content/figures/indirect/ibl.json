			"alt": "Three spheres in a row on a dark blue ground, drawn only with the light from the sky. The left sphere is an even pale blue. The middle one fades softly from blue at the top to gray-brown at the bottom, and the right one mirrors a blue sky above a sharp horizon line with gray-brown below it.",
			"project": { "sample": "ThirdPerson" },
			"camera": { "position": [0, 1.3, 5.5], "target": [0, 0.6, 0], "fov": 38 },
			"size": [1280, 720],
			"quality": "high",
			"debugView": "indirect",
			"setup": [
				{ "command": "scene.new", "parameters": { "template": "basic3d", "force": true } },
				{ "command": "component.set", "entityName": "Sun", "parameters": { "component": "DirectionalLight", "values": { "Intensity": 4.433207, "Color": [0.99292886, 1.0, 0.91019446] } } },
				{ "command": "component.set", "entityName": "Sky", "parameters": { "component": "SkyLight", "values": { "Source": "Procedural", "Intensity": 1.0, "ZenithColor": [0.18, 0.32, 0.62], "HorizonColor": [0.66, 0.74, 0.84], "GroundColor": [0.22, 0.2, 0.18] } } },
