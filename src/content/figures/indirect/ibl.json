{
	"figures": [
		{
			"id": "sky-source-spheres",
			"kind": "scene",
			"publish": "lossless",
			"shows": "A white, a rough metal and a smooth metal sphere under the same sun and four skies: an environment map, the procedural sky, the atmosphere, and no sky light, all at one fixed exposure",
			"caption": "The same sun, four skies, one fixed exposure. The map's photographed clouds show on the smooth metal. The procedural gradient and the atmosphere give it a smooth sky above the horizon. With no sky light only a constant ambient colour is left, and the metal spheres turn black wherever the sun does not reach them.",
			"alt": "Four pictures of the same three spheres on a ground: a white one, a rough metal one and a smooth metal one. Under the map the smooth metal sphere mirrors white clouds in a blue sky. Under the procedural sky it mirrors a pale, smooth gradient, and under the atmosphere a deep blue sky above a brown ground. With no sky light the background is black and the ground is a flat gray-brown. The smooth metal sphere is black but for the sun's small highlight, and the rough metal sphere is black on its shadowed half.",
			"project": { "sample": "ThirdPerson" },
			"camera": { "position": [0, 1.3, 5.5], "target": [0, 0.6, 0], "fov": 38 },
			"size": [1280, 720],
			"quality": "high",
			"postProcess": { "AutoExposure": false, "Exposure": -0.6 },
			"setup": [
				{ "command": "scene.new", "parameters": { "template": "basic3d", "force": true } },
				{ "command": "component.set", "entityName": "Sun", "parameters": { "component": "DirectionalLight", "values": { "Intensity": 4.433207, "Color": [0.99292886, 1.0, 0.91019446] } } },
				{ "command": "component.set", "entityName": "Sky", "parameters": { "component": "SkyLight", "values": { "Intensity": 1.0, "EnvironmentMap": "A76F8BB1E806ACFF", "ZenithColor": [0.18, 0.32, 0.62], "HorizonColor": [0.66, 0.74, 0.84], "GroundColor": [0.22, 0.2, 0.18] } } }
			],
			"variants": {
				"map": {
					"setup": [
						{ "command": "component.set", "entityName": "Sky", "parameters": { "component": "SkyLight", "values": { "Source": "EnvironmentMap" } } },
						{ "command": "material.create", "parameters": { "path": "Materials/MapWhite.stmat", "properties": { "BaseColor": [0.9, 0.9, 0.9, 1.0], "Roughness": 0.6 } } },
						{ "command": "entity.create", "parameters": { "name": "White", "components": { "MeshRenderer": { "Mesh": "Builtin/Sphere", "Material": "Materials/MapWhite.stmat" }, "Transform": { "Translation": [-2.2, 0.5, 0] } } } },
						{ "command": "material.create", "parameters": { "path": "Materials/MapRoughMetal.stmat", "properties": { "BaseColor": [0.9, 0.9, 0.9, 1.0], "Metallic": 1.0, "Roughness": 0.6 } } },
						{ "command": "entity.create", "parameters": { "name": "RoughMetal", "components": { "MeshRenderer": { "Mesh": "Builtin/Sphere", "Material": "Materials/MapRoughMetal.stmat" }, "Transform": { "Translation": [0.0, 0.5, 0] } } } },
						{ "command": "material.create", "parameters": { "path": "Materials/MapSmoothMetal.stmat", "properties": { "BaseColor": [0.9, 0.9, 0.9, 1.0], "Metallic": 1.0, "Roughness": 0.05 } } },
						{ "command": "entity.create", "parameters": { "name": "SmoothMetal", "components": { "MeshRenderer": { "Mesh": "Builtin/Sphere", "Material": "Materials/MapSmoothMetal.stmat" }, "Transform": { "Translation": [2.2, 0.5, 0] } } } }
					]
				},
