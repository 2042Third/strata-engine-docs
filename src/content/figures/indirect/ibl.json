				{ "command": "entity.create", "parameters": { "name": "RoughMetal", "components": { "MeshRenderer": { "Mesh": "Builtin/Sphere", "Material": "Materials/IndirectRoughMetal.stmat" }, "Transform": { "Translation": [0.0, 0.5, 0] } } } },
