{
	"figures": [
		{
			"id": "result",
			"shows": "The editor in Play: a field of spheres under the Stats overlay, the Performance panel below",
			"caption": "The result, with spheres in place of the rock: the field plays while the overlay counts the draws and the panel shows where the time goes.",
			"alt": "The editor with rows of white spheres behind a block of figures, and below them a panel with frame times, two bar graphs and a table of stage timings.",
			"kind": "editor",
			"publish": "lossy",
			"project": {
				"template": "basic3d"
			},
			"files": [
				{
					"stage": 1
				}
			],
			"editorWindow": {
				"layout": "layouts/make-performance-result.ini",
				"windowSize": [
					960,
					640
				],
				"steps": [
					{
						"command": "scene.new",
						"parameters": {
							"template": "basic3d",
							"name": "Main",
							"force": true
						}
					},
					{
						"command": "entity.create",
						"parameters": {
							"name": "Rock",
							"components": {
								"MeshRenderer": {
									"Mesh": "Builtin/Sphere"
								}
							}
						},
						"bind": {
							"rock": "/id"
						}
					},
					{
						"command": "prefab.create",
						"parameters": {
							"entities": [
								{
									"$ref": "rock"
								}
							],
							"path": "Prefabs/Rock.stprefab",
							"link": false
						}
					},
					{
						"command": "entity.delete",
						"parameters": {
							"entities": [
								{
									"$ref": "rock"
								}
							]
						}
					},
					{
						"command": "script.build",
						"parameters": {
							"wait": true
						}
					},
					{
						"command": "editor.wait",
						"parameters": {
							"frames": 600
						}
					},
					{
						"command": "entity.create",
						"parameters": {
							"name": "Field"
						},
						"bind": {
							"field": "/id"
						}
					},
					{
						"command": "script.add",
						"parameters": {
							"entity": {
								"$ref": "field"
							},
							"class": "FieldSpawner"
						}
					},
					{
						"command": "entity.create",
						"parameters": {
							"name": "Hut",
							"components": {
								"MeshRenderer": {
									"Mesh": "Builtin/Cube"
								},
								"Transform": {
									"Translation": [
										148,
										1.5,
										-14
									],
									"Scale": [
										10,
										3,
										4
									]
								}
							}
						}
					},
					{
						"command": "viewport.setSettings",
						"parameters": {
							"stats": true
						}
					},
					{
						"command": "play.start"
					},
					{
						"command": "editor.wait",
						"parameters": {
							"frames": 300
						}
					},
					{
						"command": "camera.set",
						"parameters": {
							"position": [
								-8,
								4,
								-8
							],
							"target": [
								40,
								0,
								30
							],
							"fov": 40
						}
					},
					{
						"command": "editor.showPanel",
						"parameters": {
							"panel": "Performance"
						}
					}
				]
			}
		},
