			{ "Name": "FocusDistance", "DisplayName": "Focus Distance", "Type": "Float", "Min": 0.0, "Max": 0.0 } ] },
		{ "name": "PostProcess", "displayName": "Post Process", "category": "Rendering", "description": "The image", "addable": true, "removable": true, "properties": [
			{ "Name": "Bloom", "DisplayName": "Bloom", "Type": "Bool" },
			{ "Name": "BloomIntensity", "DisplayName": "Bloom Intensity", "Type": "Float", "Section": "Bloom" },
			{ "Name": "HistoryFrames", "DisplayName": "History Frames", "Type": "UInt" } ] },
		{ "name": "Broken", "displayName": "Broken", "category": "Rendering", "description": "Refused on a new entity", "addable": true, "removable": true, "properties": [] },
		{ "name": "Name", "displayName": "Name", "category": "Core", "description": "", "addable": false, "removable": false, "properties": [ { "Name": "Name", "DisplayName": "Name", "Type": "String" } ] }
	] }
