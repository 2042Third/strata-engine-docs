{
	"page": "test/greeter",
	"startsFrom": { "template": "basic3d", "name": "Greeter" },
	"stages": [
		{
			"step": 1,
			"commands": [
				{ "command": "entity.create", "bind": { "cube": "/id" },
					"parameters": { "name": "Cube", "components": { "MeshRenderer": { "Mesh": "Builtin/Cube" }, "Transform": { "Translation": [0, 0.5, 0] } } } },
				{ "command": "component.get", "parameters": { "entity": { "$ref": "cube" }, "component": "Transform" },
					"expect": { "/values/Translation/1": { "min": 0.49, "max": 0.51 } },
					"checks": [ { "pointer": "/values/Translation", "equals": [0, 0.5, 0] } ] },
				{ "command": "entity.find", "parameters": { "name": "Sun" }, "checks": [ { "pointer": "/entities", "length": 1 } ] }
			],
			"endState": true
		},
		{
			"step": 2,
			"files": [ { "from": "book:tutorials/test/greeter/Greeter.cpp", "to": "Scripts/Greeter.cpp" } ],
			"commands": [
				{ "command": "script.build", "expect": { "/success": { "equals": true } },
					"checks": [ { "pointer": "/diagnostics", "length": 0 } ] },
				{ "command": "script.add", "entityName": "Cube", "parameters": { "class": "Greeter", "fields": { "DegreesPerStep": 0.75 } } },
				{ "command": "play.start", "parameters": { "paused": true } },
				{ "command": "play.step", "parameters": { "steps": 60 }, "expect": { "/stepsRun": { "equals": 60 } } },
				{ "command": "play.state", "until": { "steps": 10 }, "expect": { "/fixedSteps": { "min": 60 } } },
				{ "command": "component.get", "entityName": "Cube", "parameters": { "component": "Transform" },
					"checks": [ { "pointer": "/values/Rotation/1", "approx": 0.3827, "tolerance": 0.001 } ] },
				{ "command": "log.read", "parameters": { "newest": true, "limit": 100 },
					"checks": [ { "pointer": "/messages", "contains": "Hello from Greeter" } ] },
				{ "command": "play.stop" }
			],
			"endState": true
		}
	]
}
